---
import Hero from '../components/Hero.astro';
import Prompt from '../components/Prompt.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- Hides the content before first paint, so the commands can type out one by one -->
  <script is:inline>
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const root = document.documentElement;
      root.classList.add('typing');
      // A restored scroll position would leave ./hei.sh off-screen, and nothing would start
      history.scrollRestoration = 'manual';
      // If the sequence script fails to load or throws during setup, show the page anyway
      setTimeout(() => root.classList.contains('typing-started') || root.classList.remove('typing'), 3000);
    }
  </script>
  <div class="window">
    <div class="bar" aria-hidden="true">
      <span class="dots">
        <i></i>
        <i></i>
        <i></i>
      </span>
      <span class="bar-title">steffen@tommeras: ~</span>
      <span class="bar-right">zsh</span>
    </div>
    <main>
      <Prompt command="./hei.sh" />
      <Hero />

      <section>
        <Prompt command="cat om-meg.md" />
        <h2>
          <span aria-hidden="true"># </span>Om meg
        </h2>
        <p class="about">
          Hei, jeg heter Steffen Tømmerås og jobber som frontendutvikler hos Kredinor. Jeg liker å teste nye verktøy og
          måter å jobbe på, og for tiden er det mest AI. Denne siden er for eksempel skrevet om sammen med Claude Code.
        </p>
      </section>

      <section>
        <Prompt command="ls -l kontakt/" />
        <h2 class="visually-hidden">Kontakt</h2>
        <ul>
          <li>
            <span class="perm" aria-hidden="true">
              -rw-r--r--
            </span>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7" />
              <rect x="2" y="4" width="20" height="16" rx="2" />
            </svg>
            <a href="mailto:hei@tommeras.no">hei@tommeras.no</a>
          </li>
          <li>
            <span class="perm" aria-hidden="true">
              lrwxr-xr-x
            </span>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
            </svg>
            <span>
              <a href="https://github.com/stommeras">GitHub</a>{' '}
              <span class="target" aria-hidden="true">
                -> github.com/stommeras
              </span>
            </span>
          </li>
          <li>
            <span class="perm" aria-hidden="true">
              lrwxr-xr-x
            </span>
            <!-- LinkedIn icon: Font Awesome Free 6.7.2, CC BY 4.0, https://fontawesome.com/license/free -->
            <svg viewBox="0 32 448 448" fill="currentColor" aria-hidden="true">
              <path d="M416 32H31.9C14.3 32 0 46.5 0 64.3v383.4C0 465.5 14.3 480 31.9 480H416c17.6 0 32-14.5 32-32.3V64.3c0-17.8-14.4-32.3-32-32.3zM135.4 416H69V202.2h66.5V416zm-33.2-243c-21.3 0-38.5-17.3-38.5-38.5S80.9 96 102.2 96c21.2 0 38.5 17.3 38.5 38.5 0 21.3-17.2 38.5-38.5 38.5zm282.1 243h-66.4V312c0-24.8-.5-56.7-34.5-56.7-34.6 0-39.9 27-39.9 54.9V416h-66.4V202.2h63.7v29.2h.9c8.9-16.8 30.6-34.5 62.9-34.5 67.2 0 79.7 44.3 79.7 101.9V416z" />
            </svg>
            <span>
              <a href="https://www.linkedin.com/in/steffen-tommeras/">LinkedIn</a>{' '}
              <span class="target" aria-hidden="true">
                -> linkedin.com/in/steffen-tommeras
              </span>
            </span>
          </li>
        </ul>
      </section>

      <section>
        <Prompt command="ls prosjekter/" />
        <p class="err">ls: klarte ikke å åpne 'prosjekter/': Ingen slik fil eller filkatalog (ennå)</p>
      </section>

      <div class="prompt-end">
        <Prompt />
      </div>
    </main>
    <div class="status" aria-hidden="true">
      <span class="mode">NORMAL</span>
      <span>index.astro</span>
      <span class="spacer"></span>
      <span class="hide-mobile">nb_NO</span>
      <span class="hide-mobile">utf-8</span>
      <span>Ln 1, Col 1</span>
    </div>
  </div>
</Layout>

<script>
  // Each command types out when its prompt scrolls into view, then its output appears. Any key or click skips to the end.
  const root = document.documentElement;
  if (root.classList.contains('typing')) {
    const main = document.querySelector('main')!;
    const hero = main.querySelector('.hero')!;
    const about = main.querySelector<HTMLElement>('.about')!;
    let skipped = false;

    type Step = { prompt: HTMLElement; output: Element[] };
    const steps: Step[] = [{ prompt: main.querySelector(':scope > .prompt')!, output: [hero] }];
    for (const section of main.querySelectorAll('section')) {
      const [prompt, ...output] = section.children;
      steps.push({ prompt: prompt as HTMLElement, output });
    }
    steps.push({ prompt: main.querySelector('.prompt-end .prompt')!, output: [] });

    const commands = [...main.querySelectorAll<HTMLElement>('.cmd')];

    // Typed text plus a transparent remainder, so line breaks are fixed from the start
    const aboutText = about.textContent!.replace(/\s+/g, ' ').trim();
    const typed = document.createElement('span');
    const rest = document.createElement('span');
    rest.className = 'rest';

    const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
    const show = (el: Element) => {
      el.classList.add('shown');
      if (el === hero) dispatchEvent(new Event('hei'));
    };

    async function type(target: HTMLElement, text: string, ms: number, remainder?: HTMLElement) {
      for (let i = 1; i <= text.length && !skipped; i++) {
        target.textContent = text.slice(0, i);
        if (remainder) remainder.textContent = text.slice(i);
        await sleep(ms * (0.5 + Math.random()));
      }
    }

    // The next prompt waits with a blinking cursor; its command runs once it scrolls into view
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        observer.unobserve(entry.target);
        run(steps.findIndex((step) => step.prompt === entry.target));
      },
      { rootMargin: '0px 0px -15% 0px' },
    );

    // A prompt shows its cursor for at least cursorHoldMs after it appears, and always pauses
    // minPauseMs before typing, so a prompt that appears already in view doesn't type at once
    const minPauseMs = 350;
    const cursorHoldMs = 1000;
    // Average time per character; type() varies each one between half and one and a half times this
    const commandCharMs = 60;
    const aboutCharMs = 12;
    // The beat between a typed command and its output, and between the output and the next prompt
    const stepPauseMs = 250;
    let shownAt = 0;

    function wait({ prompt }: Step) {
      show(prompt);
      shownAt = performance.now();
      prompt.classList.add('current');
      if (prompt.querySelector('.cmd')) observer.observe(prompt);
    }

    async function run(index: number) {
      const { prompt, output } = steps[index];
      const cmd = prompt.querySelector<HTMLElement>('.cmd')!;
      await sleep(Math.max(minPauseMs, shownAt + cursorHoldMs - performance.now()));
      await type(cmd, cmd.dataset.text!, commandCharMs);
      await sleep(stepPauseMs);
      if (skipped) return;
      prompt.classList.remove('current');
      for (const el of output) {
        if (skipped) return;
        show(el);
        if (el === about) await type(typed, aboutText, aboutCharMs, rest);
        // Let entrance animations (the hero's) finish first; looping ones like the stars never would
        const entrances = el.getAnimations({ subtree: true }).filter((a) => a.effect?.getTiming().iterations !== Infinity);
        await Promise.all(entrances.map((a) => a.finished.catch(() => {})));
      }
      await sleep(stepPauseMs);
      if (!skipped) wait(steps[index + 1]);
    }

    function skip() {
      if (skipped) return;
      skipped = true;
      root.classList.remove('typing');
      for (const cmd of commands) cmd.textContent = cmd.dataset.text!;
      typed.textContent = aboutText;
      rest.textContent = '';
      observer.disconnect();
      for (const el of main.querySelectorAll('.current')) el.classList.remove('current');
      dispatchEvent(new Event('hei'));
    }

    for (const event of ['keydown', 'click']) addEventListener(event, skip, { once: true });

    // The DOM changes come last, so if anything above throws, the fallback in the inline script shows an intact page
    for (const cmd of commands) {
      cmd.dataset.text = cmd.textContent!.trim();
      cmd.textContent = '';
    }
    rest.textContent = aboutText;
    about.replaceChildren(typed, rest);
    root.classList.add('typing-started');
    wait(steps[0]);
  }
</script>

<style is:global>
  /* opacity keeps every box in place, so nothing shifts as content appears, and unlike visibility it
     keeps the text in the accessibility tree, so screen readers can read sections not yet shown.
     Opacity can't be undone by a child, so the end prompt is hidden itself, not its wrapper.
     :where() keeps specificity low so .shown wins. */
  html.typing :where(main, section, .prompt-end) > :where(:not(section, .prompt-end)) {
    opacity: 0;
    pointer-events: none;
  }

  html.typing .shown {
    opacity: 1;
    pointer-events: auto;
  }

  .about .rest {
    color: transparent;
  }
</style>

<style>
  .window {
    width: min(1040px, 100% - 128px);
    margin: 72px auto;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: 0 30px 60px -30px var(--shadow);
  }

  .bar,
  .status {
    background: var(--chrome);
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
  }

  .dots {
    display: flex;
    gap: 8px;
  }

  .dots i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--pink);
  }

  .dots i:nth-child(2) {
    background: var(--peach);
  }

  .dots i:nth-child(3) {
    background: var(--mint);
  }

  .bar-right {
    justify-self: end;
  }

  main {
    padding: 56px 64px 72px;
  }

  section {
    margin-top: 56px;
  }

  h2 {
    margin: 12px 0 0;
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--lavender);
  }

  .about {
    max-width: 64ch;
    margin: 12px 0 0;
  }

  ul {
    display: grid;
    gap: 4px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 44px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    margin: -1px;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .perm,
  .target {
    color: var(--muted);
  }

  li svg {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: var(--peach);
  }

  .err {
    margin: 12px 0 0;
    color: var(--peach);
    font-size: 0.9375rem;
  }

  .prompt-end {
    margin-top: 56px;
  }

  .status {
    display: flex;
    border-top: 1px solid var(--line);
  }

  .status span {
    padding: 6px 14px;
  }

  .status .mode {
    background: var(--mint);
    color: var(--surface);
    font-weight: 700;
  }

  .status .spacer {
    flex: 1;
    padding: 0;
  }

  @media (max-width: 600px) {
    .window {
      width: auto;
      margin: 0;
      border: 0;
      border-radius: 0;
      box-shadow: none;
    }

    .bar-right,
    .perm,
    .target,
    .hide-mobile {
      display: none;
    }

    main {
      padding: 32px 16px 48px;
    }

    section {
      margin-top: 44px;
    }
  }
</style>
