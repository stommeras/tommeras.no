---
import Entry from '../components/Entry.astro';
import Hero from '../components/Hero.astro';
import Prompt from '../components/Prompt.astro';
import Window from '../components/Window.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- Hides the content before first paint, so the commands can type out one by one -->
  <script is:inline>
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const root = document.documentElement;
      root.classList.add('typing');
      // A restored scroll position would leave ./hei.sh off-screen, and nothing would start
      history.scrollRestoration = 'manual';
      // If the sequence script fails to load or throws during setup, show the page anyway, and tell
      // Window.astro the sequence is over
      setTimeout(() => {
        if (root.classList.contains('typing-started')) return;
        root.classList.remove('typing');
        dispatchEvent(new Event('typed'));
      }, 3000);
    }
  </script>
  <Window path="~">
    <Prompt command="./hei.sh" />
    <Hero />

    <section>
      <Prompt command="cat om-meg.md" />
      <h2 class="title">
        <span aria-hidden="true"># </span>Om meg
      </h2>
      <p class="about">
        Hei, jeg heter Steffen Tømmerås og jobber som frontendutvikler hos Kredinor. Jeg liker å teste nye verktøy og
        måter å jobbe på, og for tiden er det mest AI. Denne siden er for eksempel skrevet om sammen med Claude Code.
      </p>
    </section>

    <section>
      <Prompt command="ls -l kontakt/" />
      <h2 class="visually-hidden">Kontakt</h2>
      <ul>
        <Entry perm="-rw-r--r--" href="mailto:hei@tommeras.no" label="hei@tommeras.no">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7" />
            <rect x="2" y="4" width="20" height="16" rx="2" />
          </svg>
        </Entry>
        <Entry perm="lrwxr-xr-x" href="https://github.com/stommeras" label="GitHub" target="github.com/stommeras">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
          </svg>
        </Entry>
        <Entry
          perm="lrwxr-xr-x"
          href="https://www.linkedin.com/in/steffen-tommeras/"
          label="LinkedIn"
          target="linkedin.com/in/steffen-tommeras"
        >
          <!-- LinkedIn icon: Font Awesome Free 6.7.2, CC BY 4.0, https://fontawesome.com/license/free -->
          <svg viewBox="0 32 448 448" fill="currentColor" aria-hidden="true">
            <path d="M416 32H31.9C14.3 32 0 46.5 0 64.3v383.4C0 465.5 14.3 480 31.9 480H416c17.6 0 32-14.5 32-32.3V64.3c0-17.8-14.4-32.3-32-32.3zM135.4 416H69V202.2h66.5V416zm-33.2-243c-21.3 0-38.5-17.3-38.5-38.5S80.9 96 102.2 96c21.2 0 38.5 17.3 38.5 38.5 0 21.3-17.2 38.5-38.5 38.5zm282.1 243h-66.4V312c0-24.8-.5-56.7-34.5-56.7-34.6 0-39.9 27-39.9 54.9V416h-66.4V202.2h63.7v29.2h.9c8.9-16.8 30.6-34.5 62.9-34.5 67.2 0 79.7 44.3 79.7 101.9V416z" />
          </svg>
        </Entry>
      </ul>
    </section>

    <section>
      <Prompt command="ls -la prosjekter/" />
      <h2 class="visually-hidden">Prosjekter</h2>
      <ul>
        <Entry perm="drwxr-xr-x" href="/prosjekter" label="./" desc="alle prosjekter med skjermbilder">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z" />
          </svg>
        </Entry>
        <Entry perm="drwxr-xr-x" href="/prosjekter/proof" label="proof/" desc="cocktaillogg med versjonshistorikk">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z" />
          </svg>
        </Entry>
        <Entry perm="drwxr-xr-x" href="/prosjekter/rabra" label="rabra/" desc="ros til kolleger for det som gikk bra">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z" />
          </svg>
        </Entry>
      </ul>
    </section>

    <div class="prompt-end">
      <Prompt />
    </div>
  </Window>
</Layout>

<script>
  // Each command types out when its prompt scrolls into view or above it, then its output appears. Any key or click skips to the end.
  //
  // Markup this script expects inside <main>:
  //   - a Prompt directly in <main>, followed by the Hero (the output of ./hei.sh)
  //   - each <section> starts with its Prompt; every later child is that prompt's output
  //   - the final Prompt, without a command, sits inside .prompt-end
  // Classes: the inline guard adds html.typing, this script adds html.typing-started, .shown on
  // each revealed element, and .current on the prompt with the cursor.
  // Events on window: "hei" when ./hei.sh's output appears, which Hero.astro waits for, and "typed"
  // when the last prompt appears or the sequence is skipped, which Window.astro waits for.
  const root = document.documentElement;
  if (root.classList.contains('typing')) {
    // A prompt shows its cursor for at least cursorHoldMs after it appears, and always pauses
    // minPauseMs before typing, so a prompt that appears already in view doesn't type at once
    const minPauseMs = 350;
    const cursorHoldMs = 1000;
    // Average time per character; type() varies each one between half and one and a half times this
    const charMs = 60;
    // The beat between a typed command and its output, and between the output and the next prompt
    const stepPauseMs = 250;

    const main = document.querySelector('main')!;
    const hero = main.querySelector('.hero')!;
    const commands = [...main.querySelectorAll<HTMLElement>('.cmd')];

    // One step per prompt. The hero is the output of ./hei.sh, each section starts with its prompt
    // followed by its output, and the end prompt has no command.
    type Step = { prompt: HTMLElement; output: Element[] };
    const steps: Step[] = [{ prompt: main.querySelector(':scope > .prompt')!, output: [hero] }];
    for (const section of main.querySelectorAll('section')) {
      const [prompt, ...output] = section.children;
      steps.push({ prompt: prompt as HTMLElement, output });
    }
    steps.push({ prompt: main.querySelector('.prompt-end .prompt')!, output: [] });

    let skipped = false;
    let shownAt = 0;

    const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

    // Hero.astro waits for this event to scramble the title
    const startHero = () => dispatchEvent(new Event('hei'));

    async function type(cmd: HTMLElement) {
      const text = cmd.dataset.text!;
      for (let i = 1; i <= text.length && !skipped; i++) {
        cmd.textContent = text.slice(0, i);
        await sleep(charMs * (0.5 + Math.random()));
      }
    }

    // Resolves when the entrance animations (the hero's) finish; looping ones like the stars never would, so they're left out
    function entranceAnimationsDone(el: Element) {
      const entrances = el
        .getAnimations({ subtree: true })
        .filter((a) => a.effect?.getTiming().iterations !== Infinity);
      return Promise.all(entrances.map((a) => a.finished.catch(() => {})));
    }

    // Like a real command's output, each element appears whole, one after the other
    async function revealOutput(output: Element[]) {
      for (const el of output) {
        if (skipped) return;
        el.classList.add('shown');
        if (el === hero) startHero();
        await entranceAnimationsDone(el);
      }
    }

    // The next prompt waits with a blinking cursor; its command runs once it scrolls into view. A visitor
    // who has scrolled past it, like one who jumped to the bottom, shouldn't have to scroll back up.
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting && entry.boundingClientRect.top > 0) return;
        observer.unobserve(entry.target);
        run(steps.findIndex((step) => step.prompt === entry.target));
      },
      { rootMargin: '0px 0px -15% 0px' },
    );

    function showPrompt({ prompt }: Step) {
      prompt.classList.add('shown', 'current');
      shownAt = performance.now();
      if (prompt.querySelector('.cmd')) observer.observe(prompt);
      else dispatchEvent(new Event('typed'));
    }

    async function run(index: number) {
      const { prompt, output } = steps[index];
      await sleep(Math.max(minPauseMs, shownAt + cursorHoldMs - performance.now()));
      await type(prompt.querySelector<HTMLElement>('.cmd')!);
      await sleep(stepPauseMs);
      if (skipped) return;
      prompt.classList.remove('current');
      await revealOutput(output);
      await sleep(stepPauseMs);
      if (!skipped) showPrompt(steps[index + 1]);
    }

    function skip() {
      if (skipped) return;
      skipped = true;
      root.classList.remove('typing');
      for (const cmd of commands) cmd.textContent = cmd.dataset.text!;
      observer.disconnect();
      for (const el of main.querySelectorAll('.current')) el.classList.remove('current');
      startHero();
      dispatchEvent(new Event('typed'));
    }

    // Moves each command's text into data-text, so type() can write it back one character at a time
    function emptyCommands() {
      for (const cmd of commands) {
        cmd.dataset.text = cmd.textContent!.trim();
        cmd.textContent = '';
      }
    }

    for (const event of ['keydown', 'click']) addEventListener(event, skip, { once: true });

    // The DOM changes come last, so if anything above throws, the fallback in the inline script shows an intact page
    emptyCommands();
    root.classList.add('typing-started');
    showPrompt(steps[0]);
  }
</script>

<style is:global>
  /* opacity keeps every box in place, so nothing shifts as content appears, and unlike visibility it
     keeps the text in the accessibility tree, so screen readers can read sections not yet shown.
     Opacity can't be undone by a child, so the end prompt is hidden itself, not its wrapper.
     :where() keeps specificity low so .shown wins. */
  html.typing :where(main, section, .prompt-end) > :where(:not(section, .prompt-end)) {
    opacity: 0;
    pointer-events: none;
  }

  html.typing .shown {
    opacity: 1;
    pointer-events: auto;
  }
</style>

<style>
  .about {
    max-width: 64ch;
    margin: 12px 0 0;
  }

  ul {
    display: grid;
    gap: 4px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }

  .prompt-end {
    margin-top: 56px;
  }
</style>
