---
import Prompt from '../components/Prompt.astro';
import Window from '../components/Window.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 | Tømmerås">
  <Window path="~">
    <Prompt command="cd /404" />
    <!-- zsh lowercases the libc error, which nb_NO translates -->
    <h1>
      cd: ingen slik fil eller filkatalog: <span class="missing">/404</span>
    </h1>
    <div class="home">
      <Prompt command="cd ~" href="/" />
    </div>
  </Window>
  <script is:inline src="/scripts/404-path.js"></script>
</Layout>

<style>
  h1 {
    margin: 12px 0 0;
    color: var(--peach);
    font-size: 0.9375rem;
    font-weight: 400;
    overflow-wrap: anywhere;
  }

  .home {
    margin-top: 32px;
  }
</style>
