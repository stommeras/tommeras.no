---
import Prompt from '../components/Prompt.astro';
import Window from '../components/Window.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 | Tømmerås">
  <Window path="~">
    <Prompt command="cd /404" />
    <!-- zsh lowercases the libc error, which nb_NO translates -->
    <h1>
      cd: ingen slik fil eller filkatalog: <span class="missing">/404</span>
    </h1>
    <div class="home">
      <Prompt command="cd ~" href="/" />
    </div>
  </Window>
  <script is:inline>
    // The page is built once as /404, so the path the visitor asked for is filled in here
    let path = location.pathname;
    try {
      path = decodeURIComponent(path);
    } catch {}
    document.querySelector('main .cmd').textContent = 'cd ' + path;
    document.querySelector('.missing').textContent = path;
  </script>
</Layout>

<style>
  h1 {
    margin: 12px 0 0;
    color: var(--peach);
    font-size: 0.9375rem;
    font-weight: 400;
    overflow-wrap: anywhere;
  }

  .home {
    margin-top: 32px;
  }
</style>
