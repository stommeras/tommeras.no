---
import Prompt from '../../components/Prompt.astro';
import Shots from '../../components/Shots.astro';
import Window from '../../components/Window.astro';
import { byPath } from '../../fs';
import Layout from '../../layouts/Layout.astro';

const path = '~/prosjekter';
const myldre = byPath(`${path}/myldre/README.md`).text!;
const proof = byPath(`${path}/proof/README.md`).text!;
const rabra = byPath(`${path}/rabra/README.md`).text!;
---

<Layout title="Prosjekter | Tømmerås" description="Prosjektene til Steffen Tømmerås, med skjermbilder.">
  <Window path={path}>
    <!-- The cd that the ./ link on the home page stands for -->
    <Prompt command="cd prosjekter" />
    <h1 class="visually-hidden">Prosjekter</h1>

    <section>
      <!-- head shows the start of each README, so the text here matches the start of the project page -->
      <Prompt path={path} command="head myldre/README.md" />
      <h2 class="title">
        <span aria-hidden="true"># </span>
        {myldre.title}
      </h2>
      <p>{myldre.body}</p>
      <Shots label="Opptak fra Myldre">
        <video
          src="/prosjekter/myldre-norge.mp4"
          poster="/prosjekter/myldre-norge.jpg"
          width="1280"
          height="800"
          muted
          loop
          playsinline
          controls
          preload="none"
          aria-label="Hele Norge en morgen i rushtiden, avspilt i 60 ganger farten: tusenvis av lysende prikker beveger seg langs kysten og rundt byene."
        ></video>
      </Shots>
      <div class="more">
        <Prompt path={path} command="cd myldre" href="/prosjekter/myldre" comment="les mer" />
      </div>
    </section>

    <section>
      <Prompt path={path} command="head proof/README.md" />
      <h2 class="title">
        <span aria-hidden="true"># </span>
        {proof.title}
      </h2>
      <p>{proof.body}</p>
      <Shots label="Skjermbilder fra demoen av Proof">
        <img
          src="/prosjekter/proof-liste.jpg"
          width="390"
          height="844"
          loading="lazy"
          alt="Oppskriftslisten i Proof, med Espresso Martini, Gin and Tonic og flere drinker i rotasjon."
        />
        <img
          src="/prosjekter/proof-oppskrift.jpg"
          width="390"
          height="844"
          loading="lazy"
          alt="Espresso Martini i Proof, med versjon 2a som den du lager nå: bilde, porsjoner og ingredienser."
        />
        <img
          src="/prosjekter/proof-tre.jpg"
          width="390"
          height="844"
          loading="lazy"
          alt="Versjonstreet til Espresso Martini: fire versjoner og én branch, med versjon 3a valgt, fem stjerner og Mr Black i stedet for Kahlúa."
        />
      </Shots>
      <div class="more">
        <Prompt path={path} command="cd proof" href="/prosjekter/proof" comment="les mer" />
      </div>
    </section>

    <section>
      <Prompt path={path} command="head rabra/README.md" />
      <h2 class="title">
        <span aria-hidden="true"># </span>
        {rabra.title}
      </h2>
      <p>{rabra.body}</p>
      <Shots label="Skjermbilde fra demoen av #Råbra">
        <img
          src="/prosjekter/rabra-feed-desktop.jpg"
          width="1280"
          height="800"
          loading="lazy"
          alt="Feeden i #Råbra på PC, med #Råbra til Kari Nordmann og Jonas Lie side om side."
        />
      </Shots>
      <div class="more">
        <Prompt path={path} command="cd rabra" href="/prosjekter/rabra" comment="les mer" />
      </div>
    </section>

    <div class="back">
      <Prompt path={path} command="cd ~" href="/" comment="forsiden" />
    </div>
  </Window>
</Layout>

<style>
  p {
    max-width: 64ch;
    margin: 12px 0 0;
  }

  .more {
    margin-top: 24px;
  }

  .back {
    margin-top: 56px;
  }
</style>
