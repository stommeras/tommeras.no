---
import Prompt from '../../components/Prompt.astro';
import Shots from '../../components/Shots.astro';
import Window from '../../components/Window.astro';
import { byPath } from '../../fs';
import Layout from '../../layouts/Layout.astro';

const path = '~/prosjekter/figment';
const readme = byPath(`${path}/README.md`).text!;
---

<Layout title="Figment | Tømmerås" description="Figment er en oppdiktet 8-bits spillkonsoll, skrevet fra bunnen av i Zig.">
  <Window path={path}>
    <!-- The cd that the figment/ link on the home page stands for -->
    <Prompt command="cd prosjekter/figment" />
    <Prompt path={path} command="cat README.md" />
    <h1 class="title">
      <span aria-hidden="true"># </span>
      {readme.title}
    </h1>
    <p>{readme.body}</p>
    <Shots label="Skjermbilder fra Figment">
      <img
        src="/prosjekter/figment-konsoll.png"
        width="1134"
        height="1952"
        loading="lazy"
        alt="Figment i nettleseren: tittelen øverst, en grå håndholdt konsoll med grønn skjerm etter selvtesten, knapper for Rogue, Tangle, Demo og Self-test, og tastene som styrer den."
      />
      <img
        src="/prosjekter/figment-rogue.png"
        width="1096"
        height="1887"
        loading="lazy"
        alt="Rogue på Figment: en figur i en hule av murstein, med et grønt monster, et hjerte og en trapp ned."
      />
      <img
        src="/prosjekter/figment-tangle.png"
        width="1096"
        height="1887"
        loading="lazy"
        alt="Tangle på Figment: en gul og en blå strek som svinger over skjermen, begge med et lite hull. Blå leder 2 mot 1."
      />
    </Shots>
    <p>
      <a href="https://figment.tommeras.no">Prøv den</a>{' '}
      <span class="target" aria-hidden="true">
        -> figment.tommeras.no
      </span>
    </p>
    <p>Velg Rogue eller Tangle under konsollen for å spille.</p>
    <p>
      <a href="https://github.com/stommeras/figment">Kildekoden</a>{' '}
      <span class="target" aria-hidden="true">
        -> github.com/stommeras/figment
      </span>
    </p>

    <section>
      <h2>
        <span aria-hidden="true">## </span>Så langt
      </h2>
      <ul>
        <li>Prosessoren kjører hele instruksjonssettet.</li>
        <li>Assembleren har etiketter, konstanter og lokale etiketter.</li>
        <li>Skjermen vises på en nettside og i terminalen.</li>
        <li>Konsollen leser taster, piper, gir tilfeldige tall og kjører 60 bilder i sekundet.</li>
        <li>Nettsiden er tegnet som en håndholdt konsoll, med en knapp for hvert program. Knappene på konsollen virker med mus og berøring.</li>
      </ul>
      <p>
        Det første spillet som prøves ut er Rogue, en roguelike som så vidt er påbegynt. Tangle er et spill for to på samme
        tastatur. Hver spiller styrer en strek som aldri stopper, og den som kjører inn i en vegg eller en strek, gir
        motstanderen et poeng.
      </p>
    </section>

    <section>
      <h2>
        <span aria-hidden="true">## </span>Teknologi
      </h2>
      <p>Zig · WebAssembly · egen assembler</p>
    </section>

    <div class="back">
      <Prompt path={path} command="cd .." href="/prosjekter" comment="alle prosjekter" />
      <Prompt path={path} command="cd ~" href="/" comment="forsiden" />
    </div>
  </Window>
</Layout>

<style>
  p {
    max-width: 64ch;
    margin: 12px 0 0;
  }

  ul {
    max-width: 64ch;
    margin: 12px 0 0;
    padding-left: 2ch;
  }

  .target {
    color: var(--muted);
    font-size: 0.8125rem;
    white-space: nowrap;
  }

  .back {
    margin-top: 56px;
  }
</style>
