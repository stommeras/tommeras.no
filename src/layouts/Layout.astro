---
import Analytics from '@vercel/analytics/astro';
import { Font } from 'astro:assets';

interface Props {
  title?: string;
}

const { title = 'Tømmerås' } = Astro.props;
---

<!doctype html>
<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Personlig nettside for Steffen Tømmerås." />
    <link rel="icon" href="/favicon.ico" />
    <Font cssVariable="--font-mono" preload />
    <title>{title}</title>
    <Analytics />
  </head>
  <body>
    <slot />
  </body>
</html>

<script>
  console.log(`
╔══════════════════════════════════════════════╗
║                                              ║
║             Velkommen, utvikler!             ║
║                                              ║
║      Nettsiden er designet og laget av       ║
║               Steffen Tømmerås               ║
║                                              ║
║              Se kildekoden på:               ║
║       github.com/stommeras/tommeras.no       ║
║                                              ║
╚══════════════════════════════════════════════╝
`);
</script>

<style is:global>
  :root {
    color-scheme: light dark;
    --bg: light-dark(#eeeaf4, #16151d);
    --surface: light-dark(#fbfafd, #1e1c27);
    --surface-2: light-dark(#e4dfee, #26232f);
    --line: light-dark(#d6d0e3, #34303f);
    --fg: light-dark(#2a2638, #e6e2f0);
    --muted: light-dark(#625c78, #a39db8);
    --pink: light-dark(#b5487a, #f2a7c3);
    --lav: light-dark(#6a51c9, #bba8f5);
    --mint: light-dark(#2c7a5d, #9edbbf);
    --peach: light-dark(#a2561c, #f3c29a);
    --shadow: rgb(40 30 70 / 0.35);
  }

  body {
    margin: 0;
    background: var(--bg) radial-gradient(var(--line) 1px, transparent 1px) 0 0 / 24px 24px;
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 1.0625rem;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: var(--fg);
    text-decoration: underline 2px var(--pink);
    text-underline-offset: 4px;
  }

  a:hover {
    color: var(--pink);
  }

  @media (max-width: 600px) {
    body {
      background-image: none;
      font-size: 0.9375rem;
    }
  }
</style>
