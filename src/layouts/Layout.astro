---
import Analytics from '@vercel/analytics/astro';
import { Font } from 'astro:assets';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Tømmerås', description = 'Personlig nettside for Steffen Tømmerås.' } = Astro.props;
---

<!doctype html>
<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Font cssVariable="--font-mono" preload={[{ style: 'normal' }, { weight: 400, style: 'italic' }]} />
    <title>{title}</title>
    <Analytics />
  </head>
  <body>
    <slot />
  </body>
</html>

<script>
  console.log(`
╔══════════════════════════════════════════════╗
║                                              ║
║             Velkommen, utvikler!             ║
║                                              ║
║      Nettsiden er designet og laget av       ║
║               Steffen Tømmerås               ║
║                                              ║
║              Se kildekoden på:               ║
║       github.com/stommeras/tommeras.no       ║
║                                              ║
╚══════════════════════════════════════════════╝
`);

  // The dot spotlight follows the pointer. The trailing comes from the transition on --mx and --my.
  addEventListener('pointermove', (event) => {
    document.documentElement.style.setProperty('--mx', `${event.clientX}px`);
    document.documentElement.style.setProperty('--my', `${event.clientY}px`);
  });
</script>

<style is:global>
  /* Registered so they can transition, which makes the spotlight trail the pointer. They start off-screen. */
  @property --mx {
    syntax: '<length>';
    inherits: true;
    initial-value: -999px;
  }

  @property --my {
    syntax: '<length>';
    inherits: true;
    initial-value: -999px;
  }

  :root {
    color-scheme: light dark;
    --bg: light-dark(#eeeaf4, #16151d);
    --surface: light-dark(#fbfafd, #1e1c27);
    --chrome: light-dark(#e4dfee, #26232f);
    --line: light-dark(#d6d0e3, #34303f);
    --fg: light-dark(#2a2638, #e6e2f0);
    --muted: light-dark(#625c78, #a39db8);
    --pink: light-dark(#b5487a, #f2a7c3);
    --lavender: light-dark(#6a51c9, #bba8f5);
    --mint: light-dark(#2c7a5d, #9edbbf);
    --peach: light-dark(#a2561c, #f3c29a);
    --shadow: rgb(40 30 70 / 0.35);
    /* Every pointermove restarts this, so a spring would never get to overshoot. A short ease-out just trails. */
    transition:
      --mx 200ms ease-out,
      --my 200ms ease-out;
  }

  body {
    margin: 0;
    overflow-x: clip;
    /* fixed keeps the dots lined up with the fixed spotlight layer below */
    background: var(--bg) radial-gradient(var(--line) 1px, transparent 1px) 0 0 / 24px 24px fixed;
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 1.0625rem;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  /* Brighter dots around the pointer, under everything else on the page */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(var(--lavender) 1px, transparent 1px) 0 0 / 24px 24px;
    mask: radial-gradient(180px at var(--mx) var(--my), #000, transparent);
  }

  a {
    color: var(--fg);
    text-decoration: underline 2px var(--pink);
    text-underline-offset: 4px;
  }

  a:hover {
    color: var(--pink);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    margin: -1px;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 600px) {
    body {
      background-image: none;
      font-size: 0.9375rem;
    }

    body::before {
      display: none;
    }
  }

  /* The spotlight still follows the pointer, just without trailing behind it */
  @media (prefers-reduced-motion: reduce) {
    :root {
      transition: none;
    }
  }
</style>
