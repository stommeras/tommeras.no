---
interface Props {
  // A copy that ./hei.sh prints at the prompt. Its title is a <p>, so the page keeps a single <h1>.
  copy?: boolean;
}

const { copy = false } = Astro.props;
const title = 'TØMMERÅS';
const Title = copy ? 'p' : 'h1';
---

<header class:list={['hero', { copy }]}>
  <Title class="name" aria-label={copy ? undefined : title}>
    {/* aria-label doesn't name a <p>, so the copy carries its title as hidden text */}
    {copy && <span class="visually-hidden">{title}</span>}
    <span aria-hidden="true" data-value={title}>
      {title}
    </span>
  </Title>
  <p class="subtitle">
    En av{' '}
    <span class="magic">
      {[0, 1, 2].map(() => (
        <span class="star" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12.983 21.186a1 1 0 0 1-1.966 0 10 10 0 0 0-8.203-8.203 1 1 0 0 1 0-1.966 10 10 0 0 0 8.203-8.203 1 1 0 0 1 1.966 0 10 10 0 0 0 8.203 8.203 1 1 0 0 1 0 1.966 10 10 0 0 0-8.203 8.203" />
          </svg>
        </span>
      ))}
      <span class="magic-text">nettsidene</span>
    </span>{' '}
    gjennom tidene.
  </p>
</header>

<script>
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZÆØÅ';
  const rand = (min: number, max: number) => Math.floor(Math.random() * (max - min + 1)) + min;

  // Sets up one hero, the page's own or a copy ./hei.sh printed at the prompt, and returns its scramble
  function init(hero: Element) {
    const name = hero.querySelector<HTMLElement>('.name')!;
    const target = name.querySelector<HTMLElement>('[data-value]')!;
    const value = target.dataset.value!;
    let interval: number | undefined;

    function scramble() {
      if (reducedMotion) return;
      let iteration = 0;
      clearInterval(interval);
      interval = setInterval(() => {
        target.textContent = [...value]
          .map((letter, index) => (index < iteration ? letter : letters[Math.floor(Math.random() * letters.length)]))
          .join('');
        if (iteration >= value.length) clearInterval(interval);
        iteration += 1 / 3;
      }, 30);
    }

    name.addEventListener('pointerenter', scramble);

    for (const [i, star] of hero.querySelectorAll<HTMLElement>('.star').entries()) {
      const move = () => {
        star.style.left = `${rand(-10, 100)}%`;
        star.style.top = `${rand(-40, 80)}%`;
        star.style.rotate = `${rand(0, 360)}deg`;
      };
      move();
      star.addEventListener('animationiteration', move);
      star.style.animationDelay = `calc(var(--pulse) * ${i} / 3)`;
    }

    return scramble;
  }

  // Only the home page has a hero of its own. Window.astro's template copy is inert and doesn't match.
  const hero = document.querySelector('.hero');
  if (hero) {
    const scramble = init(hero);
    // While the page types out its commands, the scramble waits until ./hei.sh has run
    if (document.documentElement.classList.contains('typing')) {
      addEventListener('hei', scramble, { once: true });
    } else {
      scramble();
    }
  }

  // Window.astro sends this with the copy once ./hei.sh has printed it at the prompt
  addEventListener('hero-copy', (event) => init((event as CustomEvent<Element>).detail)());
</script>

<style>
  .hero {
    overflow-x: clip;
    padding: 72px 0;
  }

  .name {
    margin: 0;
    font-size: clamp(2.75rem, 10vw, 8rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .subtitle {
    margin: 24px 0 0;
    font-size: clamp(1.1875rem, 3vw, 2.125rem);
    font-style: italic;
  }

  .magic {
    --pulse: 2s;
    position: relative;
    display: inline-block;
  }

  .magic-text {
    background: linear-gradient(to right, var(--pink), var(--lavender), var(--mint), var(--pink)) 0 / 200%;
    background-clip: text;
    color: transparent;
    white-space: nowrap;
    animation: background-pan 6s linear infinite;
  }

  .star {
    position: absolute;
    display: flex;
    width: 0.7em;
    height: 0.7em;
    color: var(--peach);
    opacity: 0.8;
    animation: twinkle var(--pulse) ease infinite;
  }

  .star:nth-child(2) {
    color: var(--lavender);
  }

  .star:nth-child(3) {
    color: var(--pink);
  }

  .star svg {
    width: 100%;
    height: 100%;
  }

  @keyframes background-pan {
    to {
      background-position: -200% center;
    }
  }

  @keyframes twinkle {
    from {
      transform: scale(0) rotate(0deg);
    }
    50% {
      transform: scale(1) rotate(90deg);
    }
    to {
      transform: scale(0) rotate(180deg);
    }
  }

  /* When ./hei.sh runs, the title fades in under the scramble, and the subtitle follows as the
     scramble settles (about 700 ms). The page's hero does it during the typed sequence, a copy at the
     prompt as soon as it's printed. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.typing) .hero:global(.shown) .name,
    .copy .name {
      animation: hero-in 300ms ease-out both;
    }

    :global(html.typing) .hero:global(.shown) .subtitle,
    .copy .subtitle {
      animation: hero-in 500ms ease-out 600ms both;
    }
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      translate: 0 0.3em;
    }
  }

  @media (max-width: 600px) {
    .hero {
      padding: 40px 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .magic-text {
      animation: none;
    }
    .star {
      display: none;
    }
  }
</style>
