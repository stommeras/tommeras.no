---
// A row of screenshots or clips for a project page, one equal column per <img> or <video> in the slot
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<!-- Scrolls sideways on phones, so it takes focus to be scrollable by keyboard too -->
<div class="shots" role="region" aria-label={label} tabindex="0">
  <slot />
</div>

<script>
  // Clips play on their own without controls, and a click, Space or Enter pauses them. Visitors who ask for reduced
  // motion get the controls instead, with the clip paused on its poster.
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  for (const video of document.querySelectorAll<HTMLVideoElement>('.shots video')) {
    if (reducedMotion) {
      video.controls = true;
      continue;
    }
    const toggle = () => (video.paused ? video.play() : video.pause());
    video.tabIndex = 0;
    video.addEventListener('click', toggle);
    video.addEventListener('keydown', (event) => {
      if (event.key !== ' ' && event.key !== 'Enter') return;
      event.preventDefault();
      toggle();
    });
    video.play().catch(() => {});
  }
</script>

<style>
  .shots {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: 16px;
    margin-top: 24px;
  }

  .shots :global(img),
  .shots :global(video) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: 12px;
  }

  .shots :global(video:not([controls])) {
    cursor: pointer;
  }

  @media (max-width: 600px) {
    .shots {
      grid-auto-columns: 75%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
    }

    /* A single shot has nothing to scroll to, so it takes the full width */
    .shots:has(> :only-child) {
      grid-auto-columns: 100%;
    }

    .shots :global(img),
    .shots :global(video) {
      scroll-snap-align: start;
    }
  }
</style>
