---
// A row of screenshots for a project page, one equal column per <img> in the slot
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<!-- Scrolls sideways on phones, so it takes focus to be scrollable by keyboard too -->
<div class="shots" role="region" aria-label={label} tabindex="0">
  <slot />
</div>

<style>
  .shots {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: 16px;
    margin-top: 24px;
  }

  .shots :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: 12px;
    transition:
      translate 700ms var(--spring),
      scale 700ms var(--spring);
  }

  .shots :global(img:hover) {
    translate: 0 -6px;
    scale: 1.03;
  }

  /* A slight tilt while a shot scrolls through the viewport, every other shot the other way.
     It uses rotate, so it doesn't fight the hover's translate and scale. */
  @supports (animation-timeline: view()) {
    .shots :global(img) {
      animation: tilt linear both;
      animation-timeline: view();
    }

    .shots :global(img:nth-child(even)) {
      animation-direction: reverse;
    }
  }

  @keyframes tilt {
    from {
      rotate: -2deg;
    }
    to {
      rotate: 2deg;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shots :global(img) {
      transition: none;
      animation: none;
    }
  }

  @media (max-width: 600px) {
    .shots {
      grid-auto-columns: 75%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
    }

    /* A single shot has nothing to scroll to, so it takes the full width */
    .shots:has(> :only-child) {
      grid-auto-columns: 100%;
    }

    .shots :global(img) {
      scroll-snap-align: start;
    }
  }
</style>
