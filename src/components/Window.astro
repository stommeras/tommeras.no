---
interface Props {
  // The path the title bar shows, as in steffen@tommeras: ~
  path: string;
  file: string;
}

const { path, file } = Astro.props;
---

<div class="window">
  <div class="bar" aria-hidden="true">
    <span class="dots">
      <i></i>
      <i></i>
      <i></i>
    </span>
    <span class="bar-title">steffen@tommeras: {path}</span>
    <span class="bar-right">zsh</span>
  </div>
  <div class="content">
    <main>
      <slot />
    </main>
    <div class="status" aria-hidden="true">
      <span class="mode">NORMAL</span>
      <span>{file}</span>
      <span class="cmdline"></span>
      <span class="hide-mobile">nb_NO</span>
      <span class="hide-mobile">utf-8</span>
      <span>Ln 1, Col 1</span>
    </div>
  </div>
</div>

<script>
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const ease = 'cubic-bezier(0.32, 0.72, 0, 1)';

  const quit = /^(q|quit|wq|x|qa|wqa)(!?)$/;

  for (const win of document.querySelectorAll<HTMLElement>('.window')) {
    const [close, minimize, maximize] = win.querySelectorAll('.dots i');
    const content = win.querySelector<HTMLElement>('.content')!;
    const mode = win.querySelector<HTMLElement>('.mode')!;
    const cmdline = win.querySelector<HTMLElement>('.cmdline')!;

    const shake = (offsets: number[], duration: number) => {
      if (reducedMotion.matches) return;
      win.animate({ translate: offsets.map((x) => `${x}px`) }, duration);
    };
    const shakeNo = () => shake([0, -10, 10, -8, 8, -4, 4, 0], 450);
    const shakeHard = () => shake([0, -24, 24, -22, 22, -18, 18, -14, 14, -10, 10, -6, 6, 0], 500);

    close.addEventListener('click', shakeNo);

    let visual = false;
    let command: string | null = null;
    let message = '';
    let error = false;

    const render = () => {
      const name = command !== null ? 'COMMAND' : visual ? 'VISUAL' : 'NORMAL';
      mode.textContent = name;
      mode.dataset.mode = name.toLowerCase();
      cmdline.textContent = command !== null ? `:${command}` : message;
      cmdline.classList.toggle('error', command === null && error);
    };

    const run = (line: string) => {
      const match = line.match(quit);
      error = true;
      if (!match) {
        message = `E492: Ikke en editorkommando: ${line}`;
      } else if (match[2]) {
        shakeHard();
        message = 'Godt forsøk.';
      } else {
        shakeNo();
        message = 'E37: Vinduet nekter å lukkes (legg til ! for å overstyre)';
      }
    };

    document.addEventListener('selectionchange', () => {
      visual = getSelection()?.isCollapsed === false;
      render();
    });

    addEventListener('keydown', (event) => {
      if (event.ctrlKey || event.metaKey || event.altKey) return;
      if (command === null) {
        if (event.key !== ':') return;
        command = '';
        message = '';
      } else if (event.key === 'Escape') {
        command = null;
      } else if (event.key === 'Enter') {
        if (command) run(command);
        command = null;
      } else if (event.key === 'Backspace') {
        command = command ? command.slice(0, -1) : null;
      } else if (event.key.length === 1) {
        command += event.key;
      } else {
        return;
      }
      event.preventDefault();
      render();
    });

    const frame = () => {
      const { width, marginTop, marginBottom, borderRadius, boxShadow } = getComputedStyle(win);
      const { top, height } = win.getBoundingClientRect();
      const onScreen = `${Math.max(0, Math.min(height, innerHeight - top))}px`;
      return { width, marginTop, marginBottom, borderRadius, boxShadow, height: onScreen, minHeight: '0px' };
    };

    const morph = (change: () => void) => {
      const from = frame();
      const contentHeight = `${content.offsetHeight}px`;
      change();
      if (reducedMotion.matches) return;
      const options = { duration: 400, easing: ease };
      win.animate([from, frame()], options);
      if (win.classList.contains('shaded')) content.animate({ height: [contentHeight, contentHeight] }, options);
    };

    const setShaded = (shaded: boolean) => {
      win.classList.toggle('shaded', shaded);
      content.inert = shaded;
    };

    minimize.addEventListener('click', () => morph(() => setShaded(!win.classList.contains('shaded'))));

    const toggleMaximize = () =>
      morph(() => {
        const rolledUp = win.classList.contains('shaded');
        win.classList.toggle('maximized', rolledUp || !win.classList.contains('maximized'));
        setShaded(false);
      });

    maximize.addEventListener('click', toggleMaximize);

    win.querySelector('.bar')!.addEventListener('dblclick', (event) => {
      if (!(event.target as Element).closest('.dots')) toggleMaximize();
    });
  }
</script>

<style>
  .window {
    /* Side margin and content padding. 16px at 600px, matching the phone layout, growing to 64px at 1200px */
    --gutter: clamp(16px, 8vw - 32px, 64px);
    width: min(1040px, 100% - 2 * var(--gutter));
    margin: 72px auto;
    /* clip, not hidden. hidden would make the window a scroll container and stop the status bar from sticking */
    overflow: clip;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: 0 30px 60px -30px var(--shadow);
  }

  .bar,
  .status {
    background: var(--chrome);
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    user-select: none;
  }

  .dots {
    display: flex;
    gap: 8px;
  }

  .dots i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--pink);
  }

  .dots i:hover {
    cursor: pointer;
    scale: 1.2;
  }

  @media (prefers-reduced-motion: no-preference) {
    .dots i {
      transition: scale 0.8s
        linear(
          0,
          0.01 0.7%,
          0.046 1.5%,
          0.192 3.2%,
          0.391 4.8%,
          0.954 8.8%,
          1.201 11%,
          1.347 13%,
          1.388 14%,
          1.41 15.1%,
          1.411 15.9%,
          1.4 16.8%,
          1.342 18.6%,
          1.256 20.3%,
          1.013 24.5%,
          0.913 26.7%,
          0.857 28.6%,
          0.831 30.6%,
          0.833 32.1%,
          0.851 33.7%,
          1.024 41.6%,
          1.055 43.8%,
          1.069 46%,
          1.061 49.3%,
          0.991 57.1%,
          0.972 61.4%,
          0.974 64.8%,
          1.011 76.7%,
          0.996 91.2%,
          1
        );
    }
  }

  .dots i:nth-child(2) {
    background: var(--peach);
  }

  .dots i:nth-child(3) {
    background: var(--mint);
  }

  .bar-right {
    justify-self: end;
  }

  .maximized {
    width: 100%;
    margin-block: 0;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    display: flex;
    flex-direction: column;
  }

  .maximized:not(.shaded) {
    min-height: 100dvh;
  }

  .content {
    overflow: clip;
  }

  .maximized:not(.shaded) .content {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .maximized main {
    flex: 1;
  }

  .shaded .content {
    height: 0;
  }

  main {
    padding: 56px var(--gutter) 72px;
  }

  main :global(section) {
    margin-top: 56px;
  }

  /* A # heading, whatever its level in the page outline */
  main :global(.title) {
    margin: 12px 0 0;
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--pink);
  }

  main :global(h2) {
    margin: 12px 0 0;
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--lavender);
  }

  .status {
    position: sticky;
    bottom: 0;
    display: flex;
    border-top: 1px solid var(--line);
  }

  .status span {
    padding: 6px 14px;
  }

  .status .mode {
    background: var(--mint);
    color: var(--surface);
    font-weight: 700;
  }

  .status .mode[data-mode='visual'] {
    background: var(--lavender);
  }

  .status .mode[data-mode='command'] {
    background: var(--peach);
  }

  .status .cmdline {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .status .cmdline.error {
    color: var(--pink);
  }

  @media (max-width: 600px) {
    .window {
      width: auto;
      margin: 0;
      border: 0;
      border-radius: 0;
      box-shadow: none;
    }

    .bar-right,
    .hide-mobile {
      display: none;
    }

    main {
      padding: 32px 16px 48px;
    }

    main :global(section) {
      margin-top: 44px;
    }
  }
</style>
