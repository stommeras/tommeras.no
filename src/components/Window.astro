---
interface Props {
  // The path the title bar shows, as in steffen@tommeras: ~
  path: string;
  file: string;
}

const { path, file } = Astro.props;
---

<div class="window">
  <div class="bar">
    <span class="dots">
      <button class="close" type="button" aria-label="Lukk vinduet"></button>
      <button class="fold" type="button" aria-label="Brett sammen vinduet" aria-expanded="true"></button>
      <button class="widen" type="button" aria-label="Gjør vinduet bredere" aria-pressed="false"></button>
    </span>
    <span class="bar-title" aria-hidden="true">steffen@tommeras: {path}</span>
    <span class="bar-right" aria-hidden="true">zsh</span>
  </div>
  <!-- Wraps everything under the title bar, so the fold button can collapse it to nothing -->
  <div class="body">
    <main>
      <slot />
    </main>
    <div class="status" aria-hidden="true">
      <span class="mode">NORMAL</span>
      <span>{file}</span>
      <span class="spacer"></span>
      <span class="hide-mobile">nb_NO</span>
      <span class="hide-mobile">utf-8</span>
      <span>Ln 1, Col 1</span>
    </div>
  </div>
</div>

<script>
  const win = document.querySelector<HTMLElement>('.window')!;
  const body = win.querySelector<HTMLElement>('.body')!;
  const fold = win.querySelector<HTMLButtonElement>('.fold')!;
  const widen = win.querySelector<HTMLButtonElement>('.widen')!;
  const dots = win.querySelector<HTMLElement>('.dots')!;

  // A class rather than :hover, so the nudge plays to the end even if the pointer leaves halfway
  dots.addEventListener('pointerover', (event) => {
    if (event.target !== dots) (event.target as HTMLElement).classList.add('nudge');
  });
  dots.addEventListener('animationend', (event) => (event.target as HTMLElement).classList.remove('nudge'));

  // The window refuses to close and shakes its head instead
  win.querySelector('.close')!.addEventListener('click', () => win.classList.add('shake'));
  // The dots' animations bubble up here too, so only the window's own shake counts
  win.addEventListener('animationend', (event) => {
    if (event.target === win) win.classList.remove('shake');
  });

  function setFolded(folded: boolean) {
    win.classList.toggle('folded', folded);
    fold.setAttribute('aria-expanded', String(!folded));
    // Keeps the hidden content out of the tab order and away from screen readers
    body.inert = folded;
    // Folding shrinks the page, and the browser would scroll up to fit, sliding the title bar down mid-animation.
    // Holding the page at its current scroll position keeps the bar still.
    document.body.style.minHeight = folded ? `${scrollY + innerHeight}px` : '';
  }

  fold.addEventListener('click', () => setFolded(!win.classList.contains('folded')));

  // Widening a folded window unfolds it too, since a wide title bar alone shows nothing new
  widen.addEventListener('click', () => {
    widen.setAttribute('aria-pressed', String(win.classList.toggle('wide')));
    setFolded(false);
  });
</script>

<style>
  .window {
    /* Side margin and content padding. 16px at 600px, matching the phone layout, growing to 64px at 1200px */
    --gutter: clamp(16px, 8vw - 32px, 64px);
    width: min(1040px, 100% - 2 * var(--gutter));
    margin: 72px auto;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: 0 30px 60px -30px var(--shadow);
    /* The 0fr to 1fr row is what lets the fold button animate the height */
    display: grid;
    grid-template-rows: auto 1fr;
    transition:
      width 700ms var(--spring),
      grid-template-rows 700ms var(--spring);
  }

  /* Capped, so the window grows by a few hundred pixels instead of jumping to the full width of a big screen */
  .window.wide {
    width: min(1280px, 100% - 2 * var(--gutter));
  }

  .window.folded {
    grid-template-rows: auto 0fr;
  }

  /* The fade hides how far the bottom edge travels when a long page folds. The height can't overshoot, so the
     bounce comes from the content dropping back in on a bouncier spring (stiffness 200, damping 12) instead. */
  .body {
    min-height: 0;
    transition:
      opacity 250ms ease-out,
      translate 1150ms
        linear(
          0, 0.05, 0.182, 0.355, 0.545, 0.731, 0.903, 1.036, 1.134, 1.196, 1.225, 1.225, 1.204, 1.17, 1.126, 1.083,
          1.042, 1.008, 0.98, 0.961, 0.951, 0.948, 0.95, 0.957, 0.966, 0.976, 0.986, 0.994, 1.002, 1.007, 1.01,
          1.012, 1.012, 1.011, 1.009, 1.007, 1.004, 1.002, 1, 0.999, 0.998, 0.997, 0.997, 0.997, 0.998, 0.998, 0.999,
          0.999, 1, 1, 1
        );
  }

  .folded .body {
    opacity: 0;
    translate: 0 -24px;
  }

  .window.shake {
    animation: shake 400ms;
  }

  @keyframes shake {
    20%,
    60% {
      translate: -8px;
    }
    40%,
    80% {
      translate: 8px;
    }
  }

  .bar,
  .status {
    background: var(--chrome);
    color: var(--muted);
    font-size: 0.8125rem;
  }

  /* Above .body, so the content slides under the title bar when it folds, not over it */
  .bar {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
  }

  .dots {
    display: flex;
    gap: 8px;
  }

  .dots button {
    width: 12px;
    height: 12px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
    background: var(--pink);
  }

  .dots button:nth-child(2) {
    background: var(--peach);
  }

  .dots button:nth-child(3) {
    background: var(--mint);
  }

  /* A flick upward, like a spring (stiffness 300, damping 14) kicked from rest: up 3px, a dip below, and settle.
     The easing is the spring's displacement over time, so the keyframe only sets the peak. */
  .dots .nudge {
    animation: nudge 830ms
      linear(
        0, 0.432, 0.724, 0.915, 0.993, 0.984, 0.902, 0.776, 0.612, 0.446, 0.274, 0.117, -0.009, -0.114, -0.184,
        -0.229, -0.247, -0.243, -0.222, -0.19, -0.149, -0.105, -0.065, -0.026, 0.004, 0.03, 0.048, 0.057, 0.061,
        0.06, 0.054, 0.046, 0.036, 0.025, 0.015, 0.006, -0.002, -0.008, -0.012, -0.014, -0.015, -0.015, -0.013,
        -0.011, -0.009, -0.006, -0.003, -0.001, 0.001, 0.002, 0
      );
  }

  @keyframes nudge {
    to {
      translate: 0 -3px;
    }
  }

  .dots button:focus-visible {
    outline: 2px solid var(--lavender);
    outline-offset: 2px;
  }

  .bar-right {
    justify-self: end;
  }

  main {
    padding: 56px var(--gutter) 72px;
  }

  main :global(section) {
    margin-top: 56px;
  }

  /* A # heading, whatever its level in the page outline */
  main :global(.title) {
    margin: 12px 0 0;
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--pink);
  }

  main :global(h2) {
    margin: 12px 0 0;
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--lavender);
  }

  .status {
    display: flex;
    border-top: 1px solid var(--line);
  }

  .status span {
    padding: 6px 14px;
  }

  .status .mode {
    background: var(--mint);
    color: var(--surface);
    font-weight: 700;
  }

  .status .spacer {
    flex: 1;
    padding: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .window,
    .body {
      transition: none;
    }

    .window.shake,
    .dots .nudge {
      animation: none;
    }
  }

  @media (max-width: 600px) {
    /* The window already fills a phone, so the widen button has nothing to do there */
    .window,
    .window.wide {
      width: auto;
      margin: 0;
      border: 0;
      border-radius: 0;
      box-shadow: none;
    }

    .bar-right,
    .widen,
    .hide-mobile {
      display: none;
    }

    main {
      padding: 32px 16px 48px;
    }

    main :global(section) {
      margin-top: 44px;
    }
  }
</style>
