---
import { items } from '../fs';
import Entry from './Entry.astro';
import Hero from './Hero.astro';
import Prompt from './Prompt.astro';

interface Props {
  // The path the title bar shows, as in steffen@tommeras: ~
  path: string;
}

const { path } = Astro.props;
---

<div class="window" data-path={path}>
  <div class="bar" aria-hidden="true">
    <span class="dots">
      <i></i>
      <i></i>
      <i></i>
    </span>
    <span class="bar-title">
      steffen@tommeras: <span class="bar-path">{path}</span>
    </span>
    <span class="bar-right">zsh</span>
  </div>
  <!-- Puts the previous page's path in the title bar before first paint, so the script below can type the change -->
  <script is:inline>
    try {
      const bar = document.querySelector('.bar-path');
      const from = sessionStorage.getItem('bar-path');
      if (from && from !== bar.textContent && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        bar.dataset.path = bar.textContent;
        bar.textContent = from;
      }
    } catch {}
  </script>
  <div class="content">
    <main>
      <slot />
      <div class="prompt-end">
        <div class="history" aria-live="polite"></div>
        <Prompt path={path} />
      </div>
    </main>
  </div>
  <!-- Every ls -l row, which the prompt copies when it lists a directory -->
  <template class="rows">
    <ul>
      {[...items].map(([path, item]) => (
        <>
          <Entry item={item} path={path} />
          {item.kind === 'dir' && <Entry item={item} path={path} self />}
        </>
      ))}
    </ul>
  </template>
  <template class="hero-copy">
    <Hero printed />
  </template>
</div>

<script>
  import { absolute, items, label, resolve, rowKey, type Item, type Text } from '../fs';
  import { setUpHero } from '../hero';
  import { add, expand, step } from '../history';

  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const ease = 'cubic-bezier(0.32, 0.72, 0, 1)';

  // Every page has exactly one Window
  const win = document.querySelector<HTMLElement>('.window')!;
  const [close, minimize, maximize] = win.querySelectorAll('.dots i');
  const content = win.querySelector<HTMLElement>('.content')!;

  const shake = (offsets: number[], duration: number) => {
    if (reducedMotion.matches) return;
    win.animate({ translate: offsets.map((x) => `${x}px`) }, duration);
  };
  const shakeSoft = () => shake([0, -10, 10, -8, 8, -4, 4, 0], 450);
  const shakeHard = () => shake([0, -43, 39, -35, 31, -27, 24, -21, 18, -15, 12, -10, 8, -6, 4, -2, 0], 900);

  close.addEventListener('click', shakeSoft);

  // Types the change from the previous path, which the inline script above put in the title bar, to this page's.
  // cd types here too when it changes directory without leaving the page.
  const bar = win.querySelector<HTMLElement>('.bar-path')!;
  let barPath = bar.dataset.path ?? bar.textContent!;
  let barTimers: number[] = [];

  const typeBar = (to: string) => {
    barPath = to;
    for (const timer of barTimers) clearTimeout(timer);
    barTimers = [];
    const from = bar.textContent!;
    if (reducedMotion.matches) {
      bar.textContent = to;
      return;
    }
    let shared = 0;
    while (shared < from.length && from[shared] === to[shared]) shared++;
    const frames = [
      ...Array.from({ length: from.length - shared }, (_, i) => from.slice(0, from.length - 1 - i)),
      ...Array.from({ length: to.length - shared }, (_, i) => to.slice(0, shared + 1 + i)),
    ];
    let at = 0;
    for (const [i, text] of frames.entries()) {
      at += i < from.length - shared ? 20 : 45;
      barTimers.push(setTimeout(() => (bar.textContent = text), at));
    }
  };

  addEventListener('pagehide', () => {
    try {
      sessionStorage.setItem('bar-path', barPath);
    } catch {}
  });

  if (bar.dataset.path) typeBar(bar.dataset.path);

  // An invisible input over the end prompt takes the typing, so phones get a keyboard and paste and dead keys work
  const log = win.querySelector<HTMLElement>('.prompt-end .history')!;
  const prompt = win.querySelector<HTMLElement>('.prompt-end > .prompt')!;
  const promptPath = prompt.querySelector('.path')!;
  const cursor = prompt.querySelector<HTMLElement>('.cursor')!;
  const before = document.createElement('span');
  const after = document.createElement('span');
  for (const span of [before, after]) {
    span.className = 'typed';
    span.setAttribute('aria-hidden', 'true');
  }
  cursor.before(before);
  cursor.after(after);

  const field = document.createElement('input');
  field.className = 'field';
  field.autocomplete = 'off';
  field.spellcheck = false;
  field.autocapitalize = 'none';
  field.enterKeyHint = 'go';
  field.setAttribute('aria-label', 'Terminal. Skriv help for å se kommandoene.');
  // The input sits inside the prompt, so the prompt can't be hidden from screen readers. Its path and arrow are.
  prompt.removeAttribute('aria-hidden');
  prompt.append(field);

  const render = () => {
    const { value } = field;
    const at = field.selectionStart ?? value.length;
    before.textContent = value.slice(0, at);
    cursor.textContent = value.slice(at, at + 1);
    after.textContent = value.slice(at + 1);
  };

  const scrollToPrompt = () =>
    prompt.scrollIntoView({ block: 'nearest', behavior: reducedMotion.matches ? 'instant' : 'smooth' });

  // History follows the visitor between pages. Each page adds the commands it ran on load, and a click on a linked
  // command adds that command, since the click runs it.
  let entries: string[] = [];
  try {
    entries = JSON.parse(sessionStorage.getItem('history') ?? '[]');
  } catch {}
  const remember = (command: string) => {
    entries = add(entries, command);
    try {
      sessionStorage.setItem('history', JSON.stringify(entries));
    } catch {}
  };
  for (const cmd of win.querySelectorAll<HTMLElement>('main span.cmd')) remember(cmd.dataset.command!);
  for (const link of win.querySelectorAll<HTMLElement>('main a.cmd')) {
    link.addEventListener('click', (event) => {
      if (event.button === 0 && !event.ctrlKey && !event.metaKey && !event.shiftKey) remember(link.dataset.command!);
    });
  }
  // The position Up and Down have stepped to, and the line they stepped away from
  let at = entries.length;
  let draft = '';

  let cwd = win.dataset.path!;
  const page = location.pathname.replace(/\/+$/, '') || '/';

  const line = (text: string, className = 'output') => {
    const p = document.createElement('p');
    p.className = className;
    p.textContent = text;
    return p;
  };

  const rows = win.querySelector<HTMLTemplateElement>('template.rows')!.content;
  const row = (path: string) => rows.querySelector(`[data-path="${CSS.escape(path)}"]`)!.cloneNode(true);
  const list = (paths: string[]) => {
    const ul = document.createElement('ul');
    ul.append(...paths.map(row));
    return ul;
  };

  const text = ({ title, body }: Text) => [...(title ? [line(`# ${title}`, 'title')] : []), line(body, 'text')];

  // ls without -l prints just the names, each linked where the long listing links it
  const names = (entries: { item: Item; self: boolean }[]) => {
    const p = line('', 'output names');
    for (const { item, self } of entries) {
      const name = document.createElement(item.href ? 'a' : 'span');
      name.textContent = label(item, self);
      if (item.href) (name as HTMLAnchorElement).href = item.href;
      p.append(name);
    }
    return p;
  };

  const find = (arg: string) => {
    const path = resolve(cwd, arg);
    const item = path && items.get(path);
    return item ? { path: path!, item } : undefined;
  };

  // The error messages follow GNU ls and cat and zsh's cd, translated the way nb_NO translates them
  const missing = 'Ingen slik fil eller filkatalog';

  const ls = (args: string[]) => {
    const options = args.filter((arg) => arg.startsWith('-') && arg !== '-');
    const unknown = options.find((option) => option.startsWith('--') && option !== '--all');
    if (unknown) return [line(`ls: ukjent valg '${unknown}'`)];
    const flags = options.map((option) => (option === '--all' ? 'a' : option.slice(1))).join('');
    const invalid = [...flags].find((flag) => !'la'.includes(flag));
    if (invalid) return [line(`ls: ugyldig valg -- '${invalid}'`)];
    const paths = args.filter((arg) => !options.includes(arg));
    const targets = paths.length ? paths : ['.'];
    return targets.flatMap((arg): Element[] => {
      const found = find(arg);
      if (!found) return [line(`ls: får ikke tilgang til '${arg}': ${missing}`)];
      const { path, item } = found;
      const entries =
        item.kind === 'dir'
          ? [
              ...(flags.includes('a') ? [{ path: rowKey(path, true), item, self: true }] : []),
              ...item.children!.map((child) => ({ path: `${path}/${child.name}`, item: child, self: false })),
            ]
          : [{ path, item, self: false }];
      const output = flags.includes('l') ? list(entries.map((entry) => entry.path)) : names(entries);
      return targets.length > 1 ? [line(`${arg}:`), output] : [output];
    });
  };

  // head prints the same as cat, since every file is shorter than head's ten lines. Without a file, real cat
  // waits for input, so here it prints nothing.
  const cat = (command: string) => (args: string[]) => {
    return args.flatMap((arg): Element[] => {
      const found = find(arg);
      if (!found) return [line(`${command}: ${arg}: ${missing}`)];
      const { path, item } = found;
      if (item.kind === 'dir') return [line(`${command}: ${arg}: Er en filkatalog`)];
      // Links and the mail address have no text, so they print the row to click instead
      return item.text ? text(item.text) : [list([path])];
    });
  };

  const cd = ([arg = '~']: string[]) => {
    const found = find(arg);
    if (!found) return [line(`cd: ingen slik fil eller filkatalog: ${arg}`)];
    const { path, item } = found;
    if (item.kind === 'link') {
      location.assign(item.href!);
      return [];
    }
    if (item.kind !== 'dir') return [line(`cd: ikke en filkatalog: ${arg}`)];
    // A directory with a page opens it. One without, like kontakt, changes directory on this page.
    if (item.href && item.href !== page) {
      location.assign(item.href);
      return [];
    }
    cwd = path;
    promptPath.textContent = path;
    typeBar(path);
    return [];
  };

  const heroCopy = win.querySelector<HTMLTemplateElement>('template.hero-copy')!.content;

  const programs: Record<string, () => Element[]> = {
    '~/hei.sh': () => [heroCopy.firstElementChild!.cloneNode(true) as Element],
  };
  const runProgram = (path: string) => programs[path]?.() ?? [];

  const exec = (arg: string) => {
    const found = find(arg);
    if (!found) return [line(`zsh: ingen slik fil eller filkatalog: ${arg}`)];
    const { path, item } = found;
    if (item.kind === 'dir') return [line(`zsh: er en filkatalog: ${arg}`)];
    if (!item.executable) return [line(`zsh: tilgang nektet: ${arg}`)];
    return runProgram(path);
  };

  const firstCommand = ({ title, body }: Text) => {
    const lines = [...(title ? [`# ${title}`] : []), ...body.split('\n')].map((text) => text.trim());
    const at = lines.findIndex((text) => text && !text.startsWith('#'));
    return at === -1 ? undefined : { lineNumber: at + 1, word: lines[at].split(/\s+/)[0] };
  };

  const sh = (command: string) => (args: string[]) => {
    const [arg] = args;
    if (!arg) return [];
    const found = find(arg);
    if (!found) return [line(`${command}: ${arg}: ${missing}`)];
    const { path, item } = found;
    if (item.kind === 'dir') return [line(`${command}: ${arg}: Er en filkatalog`)];
    if (item.executable) return runProgram(path);
    const first = item.text && firstCommand(item.text);
    return first ? [line(`${arg}: linje ${first.lineNumber}: ${first.word}: kommando ikke funnet`)] : [];
  };

  const help = () => [
    line(
      [
        './hei.sh        si hei',
        'ls [-la] [sti]  vis hva som ligger i en mappe',
        'cat <fil>       skriv ut en fil',
        'head <fil>      skriv ut starten av en fil',
        'cd [sti]        gå til en mappe',
        'pwd             vis hvor du er',
        'history         vis tidligere kommandoer',
        'clear           tøm skjermen',
        'exit            avslutt',
      ].join('\n'),
      'output pre',
    ),
  ];

  // Like zsh, the first exit warns about running jobs and an exit right after it goes through
  let warnedAboutJobs = false;

  const exit = () => {
    if (warnedAboutJobs) {
      warnedAboutJobs = false;
      shakeHard();
      return [line('Godt forsøk.')];
    }
    warnedAboutJobs = true;
    shakeSoft();
    return [line('zsh: du har jobber som kjører.')];
  };

  const commands: Record<string, (args: string[]) => Element[]> = {
    ls,
    cat: cat('cat'),
    head: cat('head'),
    cd,
    pwd: () => [line(absolute(cwd))],
    sh: sh('sh'),
    bash: sh('bash'),
    history: () => [
      line(entries.map((command, i) => `${String(i + 1).padStart(5)}  ${command}`).join('\n'), 'output pre'),
    ],
    help,
    exit,
  };

  // A command line moves into the log as typed, without the cursor or the input
  const echo = (text: string) => {
    const copy = prompt.cloneNode(true) as HTMLElement;
    copy.querySelector('.field')!.remove();
    copy.querySelector('.cursor')!.remove();
    const [typed, rest] = copy.querySelectorAll('.typed');
    typed.textContent = text;
    rest.textContent = '';
    copy.setAttribute('aria-hidden', 'true');
    return copy;
  };

  const print = (...elements: Element[]) => {
    const entry = document.createElement('div');
    entry.className = 'entry';
    entry.append(...elements);
    log.append(entry);
    for (const hero of entry.querySelectorAll('.hero')) setUpHero(hero)();
  };

  const newLine = () => {
    field.value = '';
    at = entries.length;
    draft = '';
    render();
  };

  const run = () => {
    const typed = field.value;
    const expansion = expand(entries, typed);
    if ('missing' in expansion) {
      newLine();
      print(echo(typed), line(`zsh: ingen slik hendelse: ${expansion.missing}`));
      return;
    }
    const { command, expanded } = expansion;
    remember(command);
    newLine();
    const [name, ...args] = command.trim().split(/\s+/);
    // An empty line keeps the warning, so exit, Enter, exit still goes through
    if (name && name !== 'exit') warnedAboutJobs = false;
    if (name === 'clear') {
      log.replaceChildren();
      return;
    }
    const output = !name
      ? []
      : name.includes('/')
        ? exec(name)
        : (commands[name]?.(args) ?? [line(`zsh: kommando ikke funnet: ${name}`)]);
    // Like zsh, an expanded !! or !n prints the command it became before running it
    print(echo(typed), ...(expanded ? [line(command)] : []), ...output);
  };

  field.addEventListener('input', () => {
    render();
    scrollToPrompt();
  });
  document.addEventListener('selectionchange', () => {
    if (document.activeElement === field) render();
  });
  field.addEventListener('keydown', (event) => {
    if (event.isComposing) return;
    const ctrl = event.ctrlKey && !event.altKey && !event.metaKey && !event.shiftKey;
    const key = event.key.toLowerCase();
    if (event.key === 'Enter') {
      run();
    } else if (event.key === 'ArrowUp' || event.key === 'ArrowDown') {
      if (at === entries.length) draft = field.value;
      at = step(entries, at, event.key === 'ArrowUp' ? -1 : 1);
      field.value = entries[at] ?? draft;
      field.setSelectionRange(field.value.length, field.value.length);
      render();
    } else if (ctrl && key === 'c' && field.selectionStart === field.selectionEnd && !getSelection()?.toString()) {
      // With text selected, Ctrl+C copies as usual
      print(echo(`${field.value}^C`));
      newLine();
    } else if (ctrl && key === 'l') {
      log.replaceChildren();
    } else {
      return;
    }
    event.preventDefault();
    scrollToPrompt();
  });

  // A visible character typed anywhere goes to the prompt, also from a focused link. Space, Enter and Tab don't.
  const onKeydown = (event: KeyboardEvent) => {
    if (event.ctrlKey || event.metaKey || event.altKey) return;
    if (document.activeElement?.closest('input, textarea, select, [contenteditable]')) return;
    if ((event.key.length !== 1 && event.key !== 'Dead') || event.key === ' ') return;
    field.focus({ preventScroll: true });
    scrollToPrompt();
  };

  // A click in the terminal focuses the prompt too, unless it lands on something that takes focus itself or ends
  // a text selection. On a touchscreen only a tap at the end of the page does, so reading doesn't open the keyboard.
  // Read from pointerdown, since older Safari fires click as a MouseEvent without pointerType
  let pointer = '';
  const onClick = (event: MouseEvent) => {
    const target = event.target as Element;
    if (target.closest('a, button, input, textarea, select, summary, [tabindex]')) return;
    if (!getSelection()?.isCollapsed) return;
    if (pointer === 'touch' && !target.closest('.prompt-end')) return;
    field.focus({ preventScroll: true });
  };

  const listen = () => {
    addEventListener('keydown', onKeydown);
    content.addEventListener('pointerdown', (event) => (pointer = event.pointerType));
    content.addEventListener('click', onClick);
  };

  // A listener added while index.astro's skip key is dispatching doesn't receive that key
  if (document.documentElement.classList.contains('typing')) {
    addEventListener('typed', listen, { once: true });
  } else {
    listen();
  }

  const isShaded = () => win.classList.contains('shaded');

  const snapshot = () => {
    const { width, marginTop, marginBottom, borderRadius, boxShadow } = getComputedStyle(win);
    const { top, height } = win.getBoundingClientRect();
    const onScreen = `${Math.max(0, Math.min(height, innerHeight - top))}px`;
    return { width, marginTop, marginBottom, borderRadius, boxShadow, height: onScreen, minHeight: '0px' };
  };

  const morph = (change: () => void) => {
    const from = snapshot();
    const contentHeight = `${content.offsetHeight}px`;
    change();
    if (reducedMotion.matches) return;
    const options = { duration: 400, easing: ease };
    win.animate([from, snapshot()], options);
    if (isShaded()) content.animate({ height: [contentHeight, contentHeight] }, options);
  };

  const setShaded = (shaded: boolean) => {
    win.classList.toggle('shaded', shaded);
    content.inert = shaded;
  };

  minimize.addEventListener('click', () => morph(() => setShaded(!isShaded())));

  const toggleMaximize = () =>
    morph(() => {
      const rolledUp = isShaded();
      win.classList.toggle('maximized', rolledUp || !win.classList.contains('maximized'));
      setShaded(false);
    });

  maximize.addEventListener('click', toggleMaximize);

  win.querySelector('.bar')!.addEventListener('dblclick', (event) => {
    if (!(event.target as Element).closest('.dots')) toggleMaximize();
  });
</script>

<style>
  .window {
    /* Side margin and content padding. 16px at 600px, matching the phone layout, growing to 64px at 1200px */
    --gutter: clamp(16px, 8vw - 32px, 64px);
    width: min(1040px, 100% - 2 * var(--gutter));
    margin: 72px auto;
    /* clip, not hidden. hidden would make the window a scroll container and stop the title bar from sticking */
    overflow: clip;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: 0 30px 60px -30px var(--shadow);
  }

  .bar {
    background: var(--chrome);
    color: var(--muted);
    font-size: 0.8125rem;
    position: sticky;
    top: 0;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    user-select: none;
  }

  .dots {
    display: flex;
    gap: 8px;
  }

  .dots i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--pink);
  }

  @media (hover: hover) {
    .dots i:hover {
      cursor: pointer;
      scale: 1.2;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .dots i {
      transition: scale 0.8s
        linear(
          0,
          0.01 0.7%,
          0.046 1.5%,
          0.192 3.2%,
          0.391 4.8%,
          0.954 8.8%,
          1.201 11%,
          1.347 13%,
          1.388 14%,
          1.41 15.1%,
          1.411 15.9%,
          1.4 16.8%,
          1.342 18.6%,
          1.256 20.3%,
          1.013 24.5%,
          0.913 26.7%,
          0.857 28.6%,
          0.831 30.6%,
          0.833 32.1%,
          0.851 33.7%,
          1.024 41.6%,
          1.055 43.8%,
          1.069 46%,
          1.061 49.3%,
          0.991 57.1%,
          0.972 61.4%,
          0.974 64.8%,
          1.011 76.7%,
          0.996 91.2%,
          1
        );
    }
  }

  .dots i:nth-child(2) {
    background: var(--peach);
  }

  .dots i:nth-child(3) {
    background: var(--mint);
  }

  .bar-right {
    justify-self: end;
  }

  .maximized {
    width: 100%;
    margin-block: 0;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    display: flex;
    flex-direction: column;
  }

  .maximized:not(.shaded) {
    min-height: 100dvh;
  }

  .content {
    overflow: clip;
  }

  .maximized:not(.shaded) .content {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .maximized main {
    flex: 1;
  }

  .shaded .content {
    height: 0;
  }

  main {
    --end-padding: 72px;
    padding: 56px var(--gutter) var(--end-padding);
  }

  main :global(section) {
    margin-top: 56px;
  }

  /* A # heading, whatever its level in the page outline */
  main :global(.title) {
    margin: 12px 0 0;
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--pink);
  }

  main :global(h2) {
    margin: 12px 0 0;
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--lavender);
  }

  .prompt-end {
    margin-top: 56px;
  }

  .prompt-end :global(.prompt) {
    position: relative;
    scroll-margin-bottom: var(--end-padding);
    /* Wraps at the window edge whatever the character, like a terminal, instead of moving the command below the arrow */
    word-break: break-all;
  }

  /* Keeps runs of spaces, like a terminal */
  .prompt-end :global(.typed) {
    white-space: pre-wrap;
  }

  /* The block cursor over a character, with the character in the background color */
  .prompt-end :global(.cursor:not(:empty)) {
    height: auto;
    line-height: 1.1;
    vertical-align: baseline;
    color: var(--surface);
    white-space: pre;
  }

  /* An unfocused terminal shows an outlined, steady cursor */
  .prompt-end > :global(.prompt:not(:focus-within) .cursor) {
    background: none;
    box-shadow: inset 0 0 0 1px var(--mint);
    color: inherit;
    animation: none;
  }

  /* Covers the prompt, so a tap anywhere on it focuses the input. 16px keeps iOS from zooming in. */
  .prompt-end :global(.field) {
    position: absolute;
    inset: 0;
    width: 100%;
    padding: 0;
    border: 0;
    font-size: 16px;
    opacity: 0;
    cursor: text;
  }

  /* Air between a command's output and the next prompt. A command without output gets none, like in a terminal. */
  .prompt-end :global(.entry:has(> :nth-child(2))) {
    margin-bottom: 16px;
  }

  .prompt-end :global(.output) {
    margin: 0;
