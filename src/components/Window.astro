---
import Cursor from './Cursor.astro';

interface Props {
  // The path the title bar shows, as in steffen@tommeras: ~
  path: string;
}

const { path } = Astro.props;
---

<div class="window">
  <div class="bar" aria-hidden="true">
    <span class="dots">
      <i></i>
      <i></i>
      <i></i>
    </span>
    <span class="bar-title">steffen@tommeras: {path}</span>
    <span class="bar-right">nvim</span>
  </div>
  <div class="content">
    <main>
      <slot />
    </main>
    <div class="status" aria-hidden="true">
      <span class="mode" data-mode="normal">NORMAL</span>
      <!-- The window is zsh in a Neovim :terminal buffer, named term://{cwd}//{pid}:{cmd} -->
      <span>term://~//4242:zsh</span>
      <span class="cmdline"><span class="cmdline-text"></span><Cursor /></span>
      <span class="hide-mobile">nb_NO</span>
      <span class="hide-mobile">utf-8</span>
      <span class="hide-mobile">Ln 1, Col 1</span>
    </div>
    <!-- While index.astro types its commands, the keys go to zsh, as in Neovim's terminal mode. Set
    before first paint, so the label doesn't flash NORMAL -->
    <script is:inline>
      if (document.documentElement.classList.contains('typing')) {
        const mode = document.querySelector('.window .mode');
        mode.textContent = 'TERMINAL';
        mode.dataset.mode = 'terminal';
      }
    </script>
  </div>
</div>

<script>
  type Mode = 'terminal' | 'normal' | 'visual' | 'command';

  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const ease = 'cubic-bezier(0.32, 0.72, 0, 1)';
  const quitPattern = /^(q|quit|wq|x|qa|wqa)(!?)$/;

  // Every page has exactly one Window
  const win = document.querySelector<HTMLElement>('.window')!;
  const [close, minimize, maximize] = win.querySelectorAll('.dots i');
  const content = win.querySelector<HTMLElement>('.content')!;
  const modeLabel = win.querySelector<HTMLElement>('.mode')!;
  const cmdline = win.querySelector<HTMLElement>('.cmdline')!;
  const cmdlineText = win.querySelector<HTMLElement>('.cmdline-text')!;

  const shake = (offsets: number[], duration: number) => {
    if (reducedMotion.matches) return;
    win.animate({ translate: offsets.map((x) => `${x}px`) }, duration);
  };
  const shakeSoft = () => shake([0, -10, 10, -8, 8, -4, 4, 0], 450);
  const shakeHard = () => shake([0, -43, 39, -35, 31, -27, 24, -21, 18, -15, 12, -10, 8, -6, 4, -2, 0], 900);

  let mode = modeLabel.dataset.mode as Mode;
  let line = '';
  let message = '';

  const selectionMode = (): Mode => (getSelection()?.isCollapsed === false ? 'visual' : 'normal');

  const render = () => {
    modeLabel.textContent = mode.toUpperCase();
    modeLabel.dataset.mode = mode;
    cmdlineText.textContent = mode === 'command' ? `:${line}` : message;
    cmdline.classList.toggle('error', mode !== 'command');
  };

  const run = (command: string) => {
    const match = command.match(quitPattern);
    if (!match) {
      message = `E492: Ikke en editorkommando: ${command}`;
    } else if (match[2]) {
      shakeHard();
      message = 'Godt forsøk.';
    } else {
      shakeSoft();
      message = 'E948: Jobben kjører fortsatt (legg til ! for å avslutte jobben)';
    }
  };

  close.addEventListener('click', () => {
    run('q');
    render();
  });

  document.addEventListener('selectionchange', () => {
    // The command line keeps its mode, and in terminal mode only a selection changes it
    if (mode === 'command' || (mode === 'terminal' && selectionMode() === 'normal')) return;
    mode = selectionMode();
    render();
  });

  // index.astro sends this when its commands finish typing or are skipped
  addEventListener('typed', () => {
    if (mode !== 'terminal') return;
    mode = selectionMode();
    render();
  });

  addEventListener('keydown', (event) => {
    if (event.ctrlKey || event.metaKey || event.altKey) return;
    if (mode !== 'command') {
      if (event.key !== ':') return;
      mode = 'command';
      line = '';
      message = '';
    } else if (event.key === 'Escape' || (event.key === 'Backspace' && !line)) {
      mode = selectionMode();
    } else if (event.key === 'Enter') {
      if (line) run(line);
      mode = selectionMode();
    } else if (event.key === 'Backspace') {
      line = line.slice(0, -1);
    } else if (event.key.length === 1) {
      line += event.key;
    } else {
      return;
    }
    event.preventDefault();
    render();
  });

  const isShaded = () => win.classList.contains('shaded');

  const snapshot = () => {
    const { width, marginTop, marginBottom, borderRadius, boxShadow } = getComputedStyle(win);
    const { top, height } = win.getBoundingClientRect();
    const onScreen = `${Math.max(0, Math.min(height, innerHeight - top))}px`;
    return { width, marginTop, marginBottom, borderRadius, boxShadow, height: onScreen, minHeight: '0px' };
  };

  const morph = (change: () => void) => {
    const from = snapshot();
    const contentHeight = `${content.offsetHeight}px`;
    change();
    if (reducedMotion.matches) return;
    const options = { duration: 400, easing: ease };
    win.animate([from, snapshot()], options);
    if (isShaded()) content.animate({ height: [contentHeight, contentHeight] }, options);
  };

  const setShaded = (shaded: boolean) => {
    win.classList.toggle('shaded', shaded);
    content.inert = shaded;
  };

  minimize.addEventListener('click', () => morph(() => setShaded(!isShaded())));

  const toggleMaximize = () =>
    morph(() => {
      const rolledUp = isShaded();
      win.classList.toggle('maximized', rolledUp || !win.classList.contains('maximized'));
      setShaded(false);
    });

  maximize.addEventListener('click', toggleMaximize);

  win.querySelector('.bar')!.addEventListener('dblclick', (event) => {
    if (!(event.target as Element).closest('.dots')) toggleMaximize();
  });
</script>

<style>
  .window {
    /* Side margin and content padding. 16px at 600px, matching the phone layout, growing to 64px at 1200px */
    --gutter: clamp(16px, 8vw - 32px, 64px);
    width: min(1040px, 100% - 2 * var(--gutter));
    margin: 72px auto;
    /* clip, not hidden. hidden would make the window a scroll container and stop the status bar from sticking */
    overflow: clip;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: 0 30px 60px -30px var(--shadow);
  }

  .bar,
  .status {
    background: var(--chrome);
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    user-select: none;
  }

  .dots {
    display: flex;
    gap: 8px;
  }

  .dots i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--pink);
  }

  @media (hover: hover) {
    .dots i:hover {
      cursor: pointer;
      scale: 1.2;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .dots i {
      transition: scale 0.8s
        linear(
          0,
          0.01 0.7%,
          0.046 1.5%,
          0.192 3.2%,
          0.391 4.8%,
          0.954 8.8%,
          1.201 11%,
          1.347 13%,
          1.388 14%,
          1.41 15.1%,
          1.411 15.9%,
          1.4 16.8%,
          1.342 18.6%,
          1.256 20.3%,
          1.013 24.5%,
          0.913 26.7%,
          0.857 28.6%,
          0.831 30.6%,
          0.833 32.1%,
          0.851 33.7%,
          1.024 41.6%,
          1.055 43.8%,
          1.069 46%,
          1.061 49.3%,
          0.991 57.1%,
          0.972 61.4%,
          0.974 64.8%,
          1.011 76.7%,
          0.996 91.2%,
          1
        );
    }
  }

  .dots i:nth-child(2) {
    background: var(--peach);
  }

  .dots i:nth-child(3) {
    background: var(--mint);
  }

  .bar-right {
    justify-self: end;
  }

  .maximized {
    width: 100%;
    margin-block: 0;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    display: flex;
    flex-direction: column;
  }

  .maximized:not(.shaded) {
    min-height: 100dvh;
  }

  .content {
    overflow: clip;
  }

  .maximized:not(.shaded) .content {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .maximized main {
    flex: 1;
  }

  .shaded .content {
    height: 0;
  }

  main {
    padding: 56px var(--gutter) 72px;
  }

  main :global(section) {
    margin-top: 56px;
  }

  /* A # heading, whatever its level in the page outline */
  main :global(.title) {
    margin: 12px 0 0;
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--pink);
  }

  main :global(h2) {
    margin: 12px 0 0;
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--lavender);
  }

  .status {
    position: sticky;
    bottom: 0;
    display: flex;
    border-top: 1px solid var(--line);
  }

  .status > span {
    padding: 6px 14px;
  }

  .status .mode {
    background: var(--mint);
    color: var(--surface);
    font-weight: 700;
  }

  .status .mode[data-mode='terminal'] {
    background: var(--pink);
  }

  .status .mode[data-mode='visual'] {
    background: var(--lavender);
  }

  .status .mode[data-mode='command'] {
    background: var(--peach);
  }

  .status .cmdline {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    white-space: nowrap;
  }

  .cmdline-text {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .status .cmdline.error {
    color: var(--pink);
  }

  .window:not(:has(.mode[data-mode='command'])) .cmdline :global(.cursor),
  .window:has(.mode[data-mode='command']) main :global(.cursor) {
    display: none;
  }

  .cmdline :global(.cursor) {
    flex: none;
  }

  @media (max-width: 600px) {
    .window {
      width: auto;
      margin: 0;
      border: 0;
      border-radius: 0;
      box-shadow: none;
    }

    .bar-right,
    .hide-mobile {
      display: none;
    }

    main {
      padding: 32px 16px 48px;
    }

    main :global(section) {
      margin-top: 44px;
    }
  }
</style>
