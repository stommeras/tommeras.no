---
interface Props {
  // The path the title bar shows, as in steffen@tommeras: ~
  path: string;
  file: string;
}

const { path, file } = Astro.props;
---

<div class="window">
  <div class="bar" aria-hidden="true">
    <span class="dots">
      <i></i>
      <i></i>
      <i></i>
    </span>
    <span class="bar-title">steffen@tommeras: {path}</span>
    <span class="bar-right">zsh</span>
  </div>
  <div class="content">
    <main>
      <slot />
    </main>
    <div class="status" aria-hidden="true">
      <span class="mode">NORMAL</span>
      <span>{file}</span>
      <span class="spacer"></span>
      <span class="hide-mobile">nb_NO</span>
      <span class="hide-mobile">utf-8</span>
      <span>Ln 1, Col 1</span>
    </div>
  </div>
</div>

<script>
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const ease = 'cubic-bezier(0.32, 0.72, 0, 1)';

  // Vim's visual mode: the status bar says VISUAL while text is selected
  const modes = document.querySelectorAll<HTMLElement>('.window .mode');
  document.addEventListener('selectionchange', () => {
    const visual = getSelection()?.isCollapsed === false;
    for (const mode of modes) {
      mode.textContent = visual ? 'VISUAL' : 'NORMAL';
      mode.classList.toggle('visual', visual);
    }
  });

  for (const win of document.querySelectorAll<HTMLElement>('.window')) {
    const [close, minimize, maximize] = win.querySelectorAll('.dots i');
    const content = win.querySelector<HTMLElement>('.content')!;

    close.addEventListener('click', () => {
      if (reducedMotion.matches) return;
      win.animate({ translate: ['0', '-10px', '10px', '-8px', '8px', '-4px', '4px', '0'] }, 450);
    });

    // The window's frame, copied out of the live computed style so it can be animated from.
    // Height counts only the part on screen. Over a long page's full height the visible change would be over in a blink.
    // min-height stays 0 during the animation so the maximized 100dvh doesn't override the animated height.
    const frame = () => {
      const { width, marginTop, marginBottom, borderRadius, boxShadow } = getComputedStyle(win);
      const { top, height } = win.getBoundingClientRect();
      const onScreen = `${Math.max(0, Math.min(height, innerHeight - top))}px`;
      return { width, marginTop, marginBottom, borderRadius, boxShadow, height: onScreen, minHeight: '0px' };
    };

    // Change the window's classes, then animate its frame from the old state to the new one
    const morph = (change: () => void) => {
      const from = frame();
      change();
      if (!reducedMotion.matches) win.animate([from, frame()], { duration: 400, easing: ease });
    };

    // Window shade: roll the window up into its title bar, or back down
    const setShaded = (shaded: boolean) => {
      win.classList.toggle('shaded', shaded);
      // Keeps Tab from landing on links hidden in the rolled-up window
      content.inert = shaded;
    };

    minimize.addEventListener('click', () => morph(() => setShaded(!win.classList.contains('shaded'))));

    // Maximize: fill the screen like the phone layout, and back on the next click.
    // A rolled-up window unrolls and maximizes, whatever its size was.
    const toggleMaximize = () =>
      morph(() => {
        win.classList.toggle('maximized', win.classList.contains('shaded') || !win.classList.contains('maximized'));
        setShaded(false);
      });

    maximize.addEventListener('click', toggleMaximize);

    // Double-clicking the title bar maximizes too, like on macOS. Not on the dots, which have their own clicks.
    win.querySelector('.bar')!.addEventListener('dblclick', (event) => {
      if (!(event.target as Element).closest('.dots')) toggleMaximize();
    });
  }
</script>

<style>
  .window {
    /* Side margin and content padding. 16px at 600px, matching the phone layout, growing to 64px at 1200px */
    --gutter: clamp(16px, 8vw - 32px, 64px);
    width: min(1040px, 100% - 2 * var(--gutter));
    margin: 72px auto;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: 0 30px 60px -30px var(--shadow);
  }

  .bar,
  .status {
    background: var(--chrome);
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    /* Double-clicking to maximize would otherwise select the title, and switch the status bar to VISUAL */
    user-select: none;
  }

  .dots {
    display: flex;
    gap: 8px;
  }

  .dots i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--pink);
  }

  .dots i:hover {
    cursor: pointer;
    scale: 1.2;
  }

  @media (prefers-reduced-motion: no-preference) {
    .dots i {
      transition: scale 0.8s
        linear(
          0,
          0.01 0.7%,
          0.046 1.5%,
          0.192 3.2%,
          0.391 4.8%,
          0.954 8.8%,
          1.201 11%,
          1.347 13%,
          1.388 14%,
          1.41 15.1%,
          1.411 15.9%,
          1.4 16.8%,
          1.342 18.6%,
          1.256 20.3%,
          1.013 24.5%,
          0.913 26.7%,
          0.857 28.6%,
          0.831 30.6%,
          0.833 32.1%,
          0.851 33.7%,
          1.024 41.6%,
          1.055 43.8%,
          1.069 46%,
          1.061 49.3%,
          0.991 57.1%,
          0.972 61.4%,
          0.974 64.8%,
          1.011 76.7%,
          0.996 91.2%,
          1
        );
    }
  }

  .dots i:nth-child(2) {
    background: var(--peach);
  }

  .dots i:nth-child(3) {
    background: var(--mint);
  }

  .bar-right {
    justify-self: end;
  }

  .maximized {
    width: 100%;
    margin-block: 0;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    /* Column layout so the content stretches and the status bar sits at the bottom of the screen */
    display: flex;
    flex-direction: column;
  }

  /* A rolled-up window shrinks to its title bar, even when maximized */
  .maximized:not(.shaded) {
    min-height: 100dvh;
  }

  .content {
    overflow: hidden;
  }

  .maximized .content {
    display: flex;
    flex-direction: column;
    /* flex-grow, not flex: 1. A zero flex-basis would ignore the rolled-up height: 0 */
    flex-grow: 1;
  }

  .maximized main {
    flex: 1;
  }

  .shaded .content {
    height: 0;
  }

  main {
    padding: 56px var(--gutter) 72px;
  }

  main :global(section) {
    margin-top: 56px;
  }

  /* A # heading, whatever its level in the page outline */
  main :global(.title) {
    margin: 12px 0 0;
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--pink);
  }

  main :global(h2) {
    margin: 12px 0 0;
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--lavender);
  }

  .status {
    display: flex;
    border-top: 1px solid var(--line);
  }

  .status span {
    padding: 6px 14px;
  }

  .status .mode {
    background: var(--mint);
    color: var(--surface);
    font-weight: 700;
  }

  .status .mode.visual {
    background: var(--lavender);
  }

  .status .spacer {
    flex: 1;
    padding: 0;
  }

  @media (max-width: 600px) {
    .window {
      width: auto;
      margin: 0;
      border: 0;
      border-radius: 0;
      box-shadow: none;
    }

    .bar-right,
    .hide-mobile {
      display: none;
    }

    main {
      padding: 32px 16px 48px;
    }

    main :global(section) {
      margin-top: 44px;
    }
  }
</style>
