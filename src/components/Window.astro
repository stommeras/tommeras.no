---
interface Props {
  // The path the title bar shows, as in steffen@tommeras: ~
  path: string;
  file: string;
}

const { path, file } = Astro.props;
---

<div class="window">
  <div class="bar">
    <span class="dots">
      <button class="close" type="button" aria-label="Lukk vinduet"></button>
      <button class="fold" type="button" aria-label="Brett sammen vinduet" aria-expanded="true"></button>
      <button class="widen" type="button" aria-label="Gjør vinduet bredere" aria-pressed="false"></button>
    </span>
    <span class="bar-title" aria-hidden="true">steffen@tommeras: {path}</span>
    <span class="bar-right" aria-hidden="true">zsh</span>
  </div>
  <!-- Wraps everything under the title bar, so the fold button can collapse it to nothing -->
  <div class="body">
    <main>
      <slot />
    </main>
    <div class="status" aria-hidden="true">
      <span class="mode">NORMAL</span>
      <span>{file}</span>
      <span class="spacer"></span>
      <span class="hide-mobile">nb_NO</span>
      <span class="hide-mobile">utf-8</span>
      <span>Ln 1, Col 1</span>
    </div>
  </div>
</div>

<script>
  const win = document.querySelector<HTMLElement>('.window')!;
  const body = win.querySelector<HTMLElement>('.body')!;
  const fold = win.querySelector<HTMLButtonElement>('.fold')!;
  const widen = win.querySelector<HTMLButtonElement>('.widen')!;
  const dots = win.querySelector<HTMLElement>('.dots')!;

  // A class rather than :hover, so the hop plays to the end even if the pointer leaves halfway
  dots.addEventListener('mouseenter', () => dots.classList.add('hop'));
  dots.addEventListener('animationend', (event) => {
    if (event.target === dots.lastElementChild) dots.classList.remove('hop');
  });

  // The window refuses to close and shakes its head instead
  win.querySelector('.close')!.addEventListener('click', () => win.classList.add('shake'));
  // The dots' animations bubble up here too, so only the window's own shake counts
  win.addEventListener('animationend', (event) => {
    if (event.target === win) win.classList.remove('shake');
  });

  function setFolded(folded: boolean) {
    win.classList.toggle('folded', folded);
    fold.setAttribute('aria-expanded', String(!folded));
    // Keeps the hidden content out of the tab order and away from screen readers
    body.inert = folded;
  }

  fold.addEventListener('click', () => setFolded(!win.classList.contains('folded')));

  // Widening a folded window unfolds it too, since a wide title bar alone shows nothing new
  widen.addEventListener('click', () => {
    widen.setAttribute('aria-pressed', String(win.classList.toggle('wide')));
    setFolded(false);
  });
</script>

<style>
  .window {
    /* Side margin and content padding. 16px at 600px, matching the phone layout, growing to 64px at 1200px */
    --gutter: clamp(16px, 8vw - 32px, 64px);
    width: min(1040px, 100% - 2 * var(--gutter));
    margin: 72px auto;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: 0 30px 60px -30px var(--shadow);
    /* The 0fr to 1fr row is what lets the fold button animate the height */
    display: grid;
    grid-template-rows: auto 1fr;
    /* A much softer overshoot than --spring, since the whole window moves */
    transition:
      width 500ms cubic-bezier(0.3, 1.15, 0.5, 1),
      grid-template-rows 500ms cubic-bezier(0.3, 1.15, 0.5, 1);
  }

  .window.wide {
    width: calc(100% - 2 * var(--gutter));
  }

  .window.folded {
    grid-template-rows: auto 0fr;
  }

  .body {
    min-height: 0;
  }

  .window.shake {
    animation: shake 400ms;
  }

  @keyframes shake {
    20%,
    60% {
      translate: -8px;
    }
    40%,
    80% {
      translate: 8px;
    }
  }

  .bar,
  .status {
    background: var(--chrome);
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
  }

  .dots {
    display: flex;
    gap: 8px;
  }

  .dots button {
    width: 12px;
    height: 12px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
    background: var(--pink);
  }

  .dots button:nth-child(2) {
    background: var(--peach);
    animation-delay: 70ms;
  }

  .dots button:nth-child(3) {
    background: var(--mint);
    animation-delay: 140ms;
  }

  /* The delays above turn the hop into a wave from left to right */
  .dots.hop button {
    animation-name: hop;
    animation-duration: 600ms;
    animation-timing-function: ease-out;
  }

  /* A big bounce, a small one, and a squash on each landing */
  @keyframes hop {
    25% {
      translate: 0 -6px;
      scale: 0.9 1.15;
    }
    45% {
      translate: 0;
      scale: 1.2 0.8;
    }
    65% {
      translate: 0 -2px;
      scale: 1;
    }
    80% {
      translate: 0;
      scale: 1.1 0.9;
    }
  }

  .dots button:focus-visible {
    outline: 2px solid var(--lavender);
    outline-offset: 2px;
  }

  .bar-right {
    justify-self: end;
  }

  main {
    padding: 56px var(--gutter) 72px;
  }

  main :global(section) {
    margin-top: 56px;
  }

  /* A # heading, whatever its level in the page outline */
  main :global(.title) {
    margin: 12px 0 0;
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--pink);
  }

  main :global(h2) {
    margin: 12px 0 0;
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--lavender);
  }

  .status {
    display: flex;
    border-top: 1px solid var(--line);
  }

  .status span {
    padding: 6px 14px;
  }

  .status .mode {
    background: var(--mint);
    color: var(--surface);
    font-weight: 700;
  }

  .status .spacer {
    flex: 1;
    padding: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .window {
      transition: none;
    }

    .window.shake,
    .dots.hop button {
      animation: none;
    }
  }

  @media (max-width: 600px) {
    /* The window already fills a phone, so the widen button has nothing to do there */
    .window,
    .window.wide {
      width: auto;
      margin: 0;
      border: 0;
      border-radius: 0;
      box-shadow: none;
    }

    .bar-right,
    .widen,
    .hide-mobile {
      display: none;
    }

    main {
      padding: 32px 16px 48px;
    }

    main :global(section) {
      margin-top: 44px;
    }
  }
</style>
