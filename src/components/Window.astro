---
interface Props {
  // The path the title bar shows, as in steffen@tommeras: ~
  path: string;
  // The file name in the status bar
  file: string;
}

const { path, file } = Astro.props;
---

<div class="window">
  <div class="bar" aria-hidden="true">
    <span class="dots">
      <i></i>
      <i></i>
      <i></i>
    </span>
    <span class="bar-title">steffen@tommeras: {path}</span>
    <span class="bar-right">zsh</span>
  </div>
  <main>
    <slot />
  </main>
  <div class="status" aria-hidden="true">
    <span class="mode">NORMAL</span>
    <span>{file}</span>
    <span class="spacer"></span>
    <span class="hide-mobile">nb_NO</span>
    <span class="hide-mobile">utf-8</span>
    <span>Ln 1, Col 1</span>
  </div>
</div>

<style>
  .window {
    /* Side margin and content padding. 16px at 600px, matching the phone layout, growing to 64px at 1200px */
    --gutter: clamp(16px, 8vw - 32px, 64px);
    width: min(1040px, 100% - 2 * var(--gutter));
    margin: 72px auto;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: 0 30px 60px -30px var(--shadow);
  }

  .bar,
  .status {
    background: var(--chrome);
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
  }

  .dots {
    display: flex;
    gap: 8px;
  }

  .dots i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--pink);
  }

  .dots i:nth-child(2) {
    background: var(--peach);
  }

  .dots i:nth-child(3) {
    background: var(--mint);
  }

  .bar-right {
    justify-self: end;
  }

  main {
    padding: 56px var(--gutter) 72px;
  }

  main :global(section) {
    margin-top: 56px;
  }

  main :global(h2) {
    margin: 12px 0 0;
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--lavender);
  }

  .status {
    display: flex;
    border-top: 1px solid var(--line);
  }

  .status span {
    padding: 6px 14px;
  }

  .status .mode {
    background: var(--mint);
    color: var(--surface);
    font-weight: 700;
  }

  .status .spacer {
    flex: 1;
    padding: 0;
  }

  @media (max-width: 600px) {
    .window {
      width: auto;
      margin: 0;
      border: 0;
      border-radius: 0;
      box-shadow: none;
    }

    .bar-right,
    .hide-mobile {
      display: none;
    }

    main {
      padding: 32px 16px 48px;
    }

    main :global(section) {
      margin-top: 44px;
    }
  }
</style>
