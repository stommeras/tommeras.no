---
import Cursor from './Cursor.astro';

interface Props {
  command?: string;
  path?: string;
  // Makes the command a link, for prompts that navigate, like cd ~. A linked prompt stays in the
  // accessibility tree so its link can be reached; the others are hidden from screen readers.
  href?: string;
  // A shell comment after a linked command that says where it goes, like # forsiden after cd ~.
  // It sits inside the link, so the link's accessible name explains it too.
  comment?: string;
}

const { command, path = '~', href, comment } = Astro.props;
---

<p class="prompt" class:list={{ idle: !command }} aria-hidden={href ? undefined : 'true'}>
  <span class="path" aria-hidden="true">
    {path}
  </span>{' '}
  <span class="arrow" aria-hidden="true">
    ❯
  </span>{' '}
  {command &&
    (href ? (
      <a class="cmd" href={href}>
        {command}
        <Cursor />
        {comment && <span class="comment"># {comment}</span>}
      </a>
    ) : (
      <span class="cmd">{command}</span>
    ))}
  {!href && <Cursor />}
</p>

<style>
  .prompt {
    margin: 0;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .path {
    color: var(--lavender);
  }

  .arrow {
    color: var(--mint);
  }

  /* inline-block keeps the link's underline off the comment, so only the command looks like the link */
  .comment {
    display: inline-block;
    color: var(--muted);
  }

  /* .current shows the cursor on the prompt that waits for or types its command */
  .prompt:not(.idle, .current) > :global(.cursor) {
    display: none;
  }

  /* Hidden rather than removed, so the comment doesn't shift on hover. The margin is the blank cell after the cursor. */
  a.cmd > :global(.cursor) {
    margin-right: 1ch;
    visibility: hidden;
  }

  a.cmd:is(:hover, :focus-visible) > :global(.cursor) {
    visibility: visible;
  }
</style>
