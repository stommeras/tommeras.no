---
interface Props {
  command?: string;
  path?: string;
  // Makes the command a link, for prompts that navigate, like cd ~. A linked prompt stays in the
  // accessibility tree so its link can be reached; the others are hidden from screen readers.
  href?: string;
}

const { command, path = '~', href } = Astro.props;
---

<p class="prompt" class:list={{ idle: !command }} aria-hidden={href ? undefined : 'true'}>
  <span class="path" aria-hidden="true">
    {path}
  </span>{' '}
  <span class="arrow" aria-hidden="true">
    ❯
  </span>{' '}
  {command &&
    (href ? (
      <a class="cmd" href={href}>
        {command}
      </a>
    ) : (
      <span class="cmd">{command}</span>
    ))}
  <span class="cursor" />
</p>

<style>
  .prompt {
    margin: 0;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .path {
    color: var(--lavender);
  }

  .arrow {
    color: var(--mint);
  }

  .cursor {
    display: none;
  }

  /* .current shows the cursor on the prompt that waits for or types its command */
  .idle .cursor,
  :global(.current) .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    vertical-align: -0.2em;
    background: var(--mint);
    animation: blink 1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }
</style>
