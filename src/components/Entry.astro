---
// One row of ls -l output
import { label, perm, type Item } from '../fs';
import Icon from './Icon.astro';

interface Props {
  item: Item;
  // The item's path, which the prompt in Window.astro finds the row by
  path?: string;
  // The ./ row that ls -a shows for the directory itself
  self?: boolean;
}

const { item, path, self } = Astro.props;
const name = self ? './' : label(item);
---

<li data-path={path && (self ? `${path}/.` : path)}>
  <span class="perm" aria-hidden="true">
    {perm(item)}
  </span>
  <Icon name={item.icon} />
  <span>
    {item.href ? <a href={item.href}>{name}</a> : name}{' '}
    {!self && item.target && (
      <span class="target" aria-hidden="true">
        -> {item.target}
      </span>
    )}{' '}
    {item.desc && <span class="desc">{item.desc}</span>}
  </span>
</li>

<style>
  li {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 44px;
    container-type: inline-size;
  }

  .perm,
  .target {
    color: var(--muted);
    white-space: nowrap;
  }

  /* Unlike a link target, the description is the row's only text about the entry, so it wraps instead of hiding */
  .desc {
    color: var(--muted);
  }

  /* The rows need about 603px with the link targets and 307px without them, so the targets go
     first when the row gets narrow instead of the row wrapping. */
  @container (width < 610px) {
    .target {
      display: none;
    }
  }

  li :global(svg) {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: var(--peach);
  }

  @media (max-width: 600px) {
    .perm,
    .target {
      display: none;
    }
  }
</style>
